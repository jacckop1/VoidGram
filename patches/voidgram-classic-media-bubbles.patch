@@ -2,6 +2,35 @@ import Foundation
 import UIKit
 import AVFoundation
 import TelegramCore
+import SwiftSignalKit
+import AccountContext
+
+/// A message's file on disk: at once when it is downloaded, else after fetching it.
+enum AyuLocalMedia {
+    static func fileExtension(_ name: String?, fallback: String) -> String {
+        let ext = ((name ?? "") as NSString).pathExtension
+        return ext.isEmpty ? fallback : ext
+    }
+
+    static func path(context: AccountContext, message: EngineMessage, file: TelegramMediaFile, pathExtension: String, completion: @escaping (String?) -> Void) {
+        let id = EngineMediaResource.Id(file.resource.id)
+        if let path = context.engine.resources.completedResourcePath(id: id, pathExtension: pathExtension) {
+            completion(path)
+            return
+        }
+        let fetch = messageMediaFileInteractiveFetched(context: context, message: message._asMessage(), file: file, userInitiated: true).start()
+        let _ = (context.engine.resources.data(id: id)
+        |> filter { $0.isComplete }
+        |> take(1)
+        |> timeout(300.0, queue: .mainQueue(), alternate: .complete())
+        |> deliverOnMainQueue).start(next: { _ in
+            fetch.dispose()
+            completion(context.engine.resources.completedResourcePath(id: id, pathExtension: pathExtension))
+        }, completed: {
+            fetch.dispose()
+        })
+    }
+}
 
