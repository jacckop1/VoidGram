+// VoidGram: the project's owner and sponsors (anyone with a badge in the registry) get an accented
+// bubble, where supporter badges are shown at all.
+private func ayuBubbleAccentColors(item: ChatMessageItem) -> [UIColor]? {
+    guard item.context.account.network.ayuGhostMode.current.interface.showSupporterBadges, let author = item.message.author, author.id.namespace == Namespaces.Peer.CloudUser else {
+        return nil
+    }
+    let id = author.id.id._internalGetInt64Value()
+    if AyuSupportersManager.shared.ownerPeerId == id {
+        return [UIColor(rgb: 0x8E7CFF), UIColor(rgb: 0x4FC3F7)]
+    }
+    if AyuSupportersManager.shared.isSupporter(peerId: id) {
+        return [UIColor(rgb: 0xF6C26B), UIColor(rgb: 0xF28CB1)]
+    }
+    return nil
+}
diff --git a/submodules/TelegramUI/Sources/AyuVideoCircle.swift b/submodules/TelegramUI/Sources/AyuVideoCircle.swift
