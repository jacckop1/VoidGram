+/// A stretchable bubble image as a mask layer's contents, stretched like the image view stretches it.
+private func ayuApplyStretchable(_ image: UIImage, to layer: CALayer?) {
+    guard let layer, let cgImage = image.cgImage else {
+        return
+    }
+    layer.contents = cgImage
+    layer.contentsScale = image.scale
+    let size = image.size
+    let insets = image.capInsets
+    if size.width > 0.0, size.height > 0.0 {
+        layer.contentsCenter = CGRect(x: insets.left / size.width, y: insets.top / size.height, width: max(0.0, size.width - insets.left - insets.right) / size.width, height: max(0.0, size.height - insets.top - insets.bottom) / size.height)
+    }
+}
+
+/// The bubble's shape in plain white, as a fill and as an outline, for the accent masks.
+private func ayuBubbleShapes(type: ChatMessageBackgroundType, graphics: PrincipalThemeEssentialGraphics) -> (fill: UIImage?, outline: UIImage?) {
+    let incoming: Bool
+    let mergeType: ChatMessageBackgroundMergeType
+    switch type {
+    case .none:
+        return (nil, nil)
+    case let .incoming(value):
+        incoming = true
+        mergeType = value
+    case let .outgoing(value):
+        incoming = false
+        mergeType = value
+    }
+    let neighbors: MessageBubbleImageNeighbors
+    switch mergeType {
+    case .None: neighbors = .none
+    case let .Top(side): neighbors = .top(side: side)
+    case .Bottom: neighbors = .bottom
+    case .Both: neighbors = .both
+    case .Side: neighbors = .side
+    case .Extracted: neighbors = .extracted
+    }
+    return (graphics.ayuAccentShape(incoming: incoming, neighbors: neighbors, outline: false), graphics.ayuAccentShape(incoming: incoming, neighbors: neighbors, outline: true))
+}
