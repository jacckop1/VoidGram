+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import Pasteboard
+import SaveToCameraRoll
+import UndoUI
+import ChatControllerInteraction
+
+extension ChatControllerImpl {
+    /// VoidGram's swipe menu; a reply goes through `setupReply` as a plain swipe does.
+    func ayuPerformSwipeMenu(action: ChatControllerAyuSwipeAction, messages: [EngineRawMessage]) {
+        let presentationData = self.context.sharedContext.currentPresentationData.with { $0 }
+        let ru = presentationData.strings.baseLanguageCode.hasPrefix("ru")
+        let context = self.context
+        switch action {
+        case .reply:
+            break
+        case .forward:
+            self.forwardMessages(messages: messages, options: nil, resetCurrent: false)
+        case .copy:
+            guard let message = messages.first(where: { !$0.text.isEmpty }) else {
+                return
+            }
+            let entities = message.attributes.compactMap({ $0 as? TextEntitiesMessageAttribute }).first?.entities
+            storeMessageTextInPasteboard(message.text, entities: entities)
+            self.present(UndoOverlayController(presentationData: presentationData, content: .copy(text: presentationData.strings.Conversation_MessageCopied), elevatedLayout: false, animateInAsReplacement: false, action: { _ in return false }), in: .current)
+        case .save:
+            var items: [(EngineRawMessage, AnyMediaReference)] = []
+            for message in messages {
+                for media in message.media {
+                    if media is TelegramMediaImage {
+                        items.append((message, .message(message: MessageReference(message), media: media)))
+                    } else if let file = media as? TelegramMediaFile, file.isVideo, !file.isInstantVideo {
+                        items.append((message, .message(message: MessageReference(message), media: media)))
+                    }
+                }
+            }
+            if items.isEmpty {
+                return
+            }
+            let total = items.count
+            var finished = 0
+            for (message, reference) in items {
+                let _ = (saveToCameraRoll(context: context, userLocation: .peer(message.id.peerId), mediaReference: reference)
+                |> deliverOnMainQueue).startStandalone(completed: { [weak self] in
+                    finished += 1
+                    if finished == total {
+                        let text = total == 1 ? (ru ? "Сохранено в галерею" : "Saved to gallery") : (ru ? "Сохранено в галерею: \(total)" : "\(total) items saved to gallery")
+                        self?.present(UndoOverlayController(presentationData: presentationData, content: .mediaSaved(text: text), elevatedLayout: false, animateInAsReplacement: false, action: { _ in return true }), in: .current)
+                    }
+                })
+            }
+        case .favorite:
+            guard let file = messages.flatMap({ $0.media }).compactMap({ $0 as? TelegramMediaFile }).first(where: { $0.isSticker || $0.isAnimatedSticker || $0.isVideoSticker }) else {
+                return
+            }
+            let _ = (context.engine.stickers.toggleStickerSaved(file: file, saved: true)
+            |> deliverOnMainQueue).startStandalone(next: { [weak self] _ in
+                self?.present(UndoOverlayController(presentationData: presentationData, content: .sticker(context: context, file: file, loop: true, title: nil, text: presentationData.strings.Conversation_StickerAddedToFavorites, undoText: nil, customAction: nil), elevatedLayout: false, action: { _ in return false }), in: .current)
+            })
+        }
+    }
+}
