--- /dev/null
+++ b/submodules/TelegramUI/Components/Chat/ChatMessageSwipeToReplyNode/Sources/AyuSwipeMenu.swift
@@ -0,0 +1,158 @@
+import Foundation
+import UIKit
+import Display
+import AsyncDisplayKit
+import TelegramCore
+import ChatControllerInteraction
+
+/// The actions a swiped message offers: a column beside it, with the one under the finger named.
+/// Moving the finger up or down chooses; releasing past the swipe distance performs it.
+public final class AyuSwipeMenuSession {
+    private static let rowHeight: CGFloat = 38.0
+    private static let width: CGFloat = 38.0
+
+    public let node = ASDisplayNode()
+    private let actions: [ChatControllerAyuSwipeAction]
+    private let baseIndex: Int
+    private let russian: Bool
+    private let foregroundColor: UIColor
+    private let highlight = UIView()
+    private let label = UILabel()
+    private let labelBackground = UIView()
+    private var icons: [UIImageView] = []
+    private var selectedIndex: Int
+
+    public var selectedAction: ChatControllerAyuSwipeAction {
+        return self.actions[self.selectedIndex]
+    }
+
+    /// A message with no reply can still be swiped for its other actions, unless it's an ad or not
+    /// on the server yet.
+    public static func canOpen(without message: EngineRawMessage) -> Bool {
+        if message.id.namespace != Namespaces.Message.Cloud {
+            return false
+        }
+        return message.adAttribute == nil
+    }
+
+    private static func actions(messages: [EngineRawMessage], canReply: Bool) -> [ChatControllerAyuSwipeAction] {
+        guard let first = messages.first else {
+            return []
+        }
+        let protected = first.isCopyProtected()
+        var result: [ChatControllerAyuSwipeAction] = []
+        if !protected && first.id.namespace == Namespaces.Message.Cloud {
+            result.append(.forward)
+        }
+        if canReply {
+            result.append(.reply)
+        }
+        if !protected {
+            let media = messages.flatMap { $0.media }
+            if media.contains(where: { ($0 as? TelegramMediaFile)?.isSticker == true || ($0 as? TelegramMediaFile)?.isAnimatedSticker == true || ($0 as? TelegramMediaFile)?.isVideoSticker == true }) {
+                result.append(.favorite)
+            } else if media.contains(where: { $0 is TelegramMediaImage || (($0 as? TelegramMediaFile)?.isVideo == true && ($0 as? TelegramMediaFile)?.isInstantVideo == false) }) {
+                result.append(.save)
+            } else if messages.contains(where: { !$0.text.isEmpty }) {
+                result.append(.copy)
+            }
+        }
+        return result
+    }
+
+    private static func symbol(_ action: ChatControllerAyuSwipeAction) -> String {
+        switch action {
+        case .forward: return "arrowshape.turn.up.right.fill"
+        case .reply: return "arrowshape.turn.up.left.fill"
+        case .copy: return "doc.on.doc.fill"
+        case .save: return "square.and.arrow.down.fill"
+        case .favorite: return "star.fill"
+        }
+    }
+
+    private func title(_ action: ChatControllerAyuSwipeAction) -> String {
+        switch action {
+        case .forward: return self.russian ? "Переслать" : "Forward"
+        case .reply: return self.russian ? "Ответить" : "Reply"
+        case .copy: return self.russian ? "Копировать" : "Copy"
+        case .save: return self.russian ? "Сохранить" : "Save"
+        case .favorite: return self.russian ? "В избранное" : "Add to Favorites"
+        }
+    }
+
+    public init?(messages: [EngineRawMessage], canReply: Bool, fillColor: UIColor, foregroundColor: UIColor, accentColor: UIColor, russian: Bool) {
+        let actions = AyuSwipeMenuSession.actions(messages: messages, canReply: canReply)
+        if actions.isEmpty {
+            return nil
+        }
+        self.actions = actions
+        let baseIndex = actions.firstIndex(of: .reply) ?? 0
+        self.baseIndex = baseIndex
+        self.selectedIndex = baseIndex
+        self.russian = russian
+        self.foregroundColor = foregroundColor
+
+        let height = CGFloat(actions.count) * AyuSwipeMenuSession.rowHeight
+        self.node.isUserInteractionEnabled = false
+        self.node.alpha = 0.0
+        self.node.bounds = CGRect(x: 0.0, y: 0.0, width: AyuSwipeMenuSession.width, height: height)
+        self.node.backgroundColor = fillColor
+        self.node.cornerRadius = AyuSwipeMenuSession.width / 2.0
+
+        self.highlight.backgroundColor = accentColor
+        self.highlight.layer.cornerRadius = (AyuSwipeMenuSession.width - 4.0) / 2.0
+        self.node.view.addSubview(self.highlight)
+
+        let configuration = UIImage.SymbolConfiguration(pointSize: 15.0, weight: .semibold)
+        for (index, action) in actions.enumerated() {
+            let icon = UIImageView(image: UIImage(systemName: AyuSwipeMenuSession.symbol(action), withConfiguration: configuration)?.withRenderingMode(.alwaysTemplate))
+            icon.contentMode = .center
+            icon.frame = CGRect(x: 0.0, y: CGFloat(index) * AyuSwipeMenuSession.rowHeight, width: AyuSwipeMenuSession.width, height: AyuSwipeMenuSession.rowHeight)
+            self.node.view.addSubview(icon)
+            self.icons.append(icon)
+        }
+
+        self.labelBackground.backgroundColor = accentColor
+        self.labelBackground.layer.cornerRadius = 13.0
+        self.label.font = Font.semibold(13.0)
+        self.label.textColor = .white
+        self.labelBackground.addSubview(self.label)
+        self.node.view.addSubview(self.labelBackground)
+
+        self.applySelection()
+    }
+
+    private func applySelection() {
+        let rowHeight = AyuSwipeMenuSession.rowHeight
+        let rowY = CGFloat(self.selectedIndex) * rowHeight
+        self.highlight.frame = CGRect(x: 2.0, y: rowY + (rowHeight - (AyuSwipeMenuSession.width - 4.0)) / 2.0, width: AyuSwipeMenuSession.width - 4.0, height: AyuSwipeMenuSession.width - 4.0)
+        for (index, icon) in self.icons.enumerated() {
+            icon.tintColor = index == self.selectedIndex ? .white : self.foregroundColor
+        }
+        self.label.text = self.title(self.selectedAction)
+        self.label.sizeToFit()
+        let labelSize = CGSize(width: self.label.bounds.width + 20.0, height: 26.0)
+        self.labelBackground.frame = CGRect(x: -labelSize.width - 6.0, y: rowY + (rowHeight - labelSize.height) / 2.0, width: labelSize.width, height: labelSize.height)
+        self.label.frame = CGRect(x: 10.0, y: floor((labelSize.height - self.label.bounds.height) / 2.0), width: self.label.bounds.width, height: self.label.bounds.height)
+    }
+
+    /// Returns whether the finger moved to another action.
+    public func update(position: CGPoint, verticalTranslation: CGFloat, progress: CGFloat) -> Bool {
+        self.node.position = position
+        self.node.alpha = max(0.0, min(1.0, progress * 1.4 - 0.2))
+        let target = max(0, min(self.actions.count - 1, self.baseIndex + Int((verticalTranslation / AyuSwipeMenuSession.rowHeight).rounded())))
+        if target == self.selectedIndex {
+            return false
+        }
+        self.selectedIndex = target
+        self.applySelection()
+        return true
+    }
+
+    public func animateOut() {
+        let node = self.node
+        node.layer.animateAlpha(from: node.alpha, to: 0.0, duration: 0.2, removeOnCompletion: false, completion: { [weak node] _ in
+            node?.removeFromSupernode()
+        })
+    }
+}
