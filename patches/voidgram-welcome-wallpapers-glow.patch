@@ -0,0 +1,158 @@
+import Foundation
+import UIKit
+import Display
+
+/// VoidGram's first screen: a lit logo on black and a white button.
+final class AyuWelcomeView: UIView {
+    private final class StartButton: UIButton {
+        override var isHighlighted: Bool {
+            didSet {
+                self.alpha = self.isHighlighted ? 0.7 : 1.0
+            }
+        }
+    }
+
+    private let lightLayer = CAGradientLayer()
+    private let logoLightLayer = CAGradientLayer()
+    private let logoView = UIImageView()
+    private let textContainer = UIView()
+    private let subtitleLabel = UILabel()
+    private let titleLabel = UILabel()
+    private let button = StartButton(type: .custom)
+
+    var pressed: (() -> Void)?
+
+    var buttonTitle: String {
+        return self.button.title(for: .normal) ?? ""
+    }
+
+    var buttonFrame: CGRect {
+        return self.button.frame
+    }
+
+    var isEnabled: Bool = true {
+        didSet {
+            self.button.isEnabled = self.isEnabled
+            self.button.alpha = self.isEnabled ? 1.0 : 0.6
+        }
+    }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+
+        self.backgroundColor = .black
+        let ru = Locale.preferredLanguages.first?.hasPrefix("ru") ?? false
+
+        for layer in [self.lightLayer, self.logoLightLayer] {
+            layer.type = .radial
+            layer.startPoint = CGPoint(x: 0.5, y: 0.5)
+            layer.endPoint = CGPoint(x: 1.0, y: 1.0)
+            self.layer.addSublayer(layer)
+        }
+        self.lightLayer.colors = [UIColor(white: 1.0, alpha: 0.26).cgColor, UIColor(white: 1.0, alpha: 0.08).cgColor, UIColor(white: 1.0, alpha: 0.0).cgColor]
+        self.lightLayer.locations = [0.0, 0.5, 1.0]
+        self.logoLightLayer.colors = [UIColor(white: 1.0, alpha: 0.42).cgColor, UIColor(white: 1.0, alpha: 0.0).cgColor]
+
+        self.logoView.image = Bundle.main.path(forResource: "VoidGramWelcomeLogo@3x", ofType: "png").flatMap(UIImage.init(contentsOfFile:)).flatMap { image -> UIImage? in
+            return image.cgImage.map { UIImage(cgImage: $0, scale: 3.0, orientation: .up) }
+        }
+        self.logoView.contentMode = .scaleAspectFit
+        // The logo's own shape lights up, not a box around it.
+        self.logoView.layer.shadowColor = UIColor.white.cgColor
+        self.logoView.layer.shadowOffset = CGSize()
+        self.logoView.layer.shadowRadius = 22.0
+        self.logoView.layer.shadowOpacity = 0.9
+        self.addSubview(self.logoView)
+
+        self.subtitleLabel.numberOfLines = 0
+        self.subtitleLabel.textAlignment = .center
+        self.subtitleLabel.textColor = .white
+        self.subtitleLabel.font = Font.regular(16.0)
+        self.subtitleLabel.text = ru ? "Добро пожаловать в VoidGram!\nБыстрый и неофициальный клиент" : "Welcome to VoidGram!\nA fast unofficial client"
+        self.textContainer.addSubview(self.subtitleLabel)
+
+        self.titleLabel.textAlignment = .center
+        self.titleLabel.textColor = .white
+        self.titleLabel.font = Font.medium(32.0)
+        self.titleLabel.text = "VoidGram"
+        self.textContainer.addSubview(self.titleLabel)
+        self.addSubview(self.textContainer)
+
+        self.button.backgroundColor = .white
+        self.button.setTitleColor(.black, for: .normal)
+        self.button.titleLabel?.font = Font.semibold(17.0)
+        self.button.setTitle(ru ? "Начать общение" : "Start Messaging", for: .normal)
+        self.button.accessibilityIdentifier = "Auth.Welcome.StartButton"
+        self.button.layer.cornerRadius = 25.0
+        self.button.layer.shadowColor = UIColor.white.cgColor
+        self.button.layer.shadowOffset = CGSize()
+        self.button.layer.shadowRadius = 18.0
+        self.button.layer.shadowOpacity = 0.35
+        self.button.addTarget(self, action: #selector(self.buttonPressed), for: .touchUpInside)
+        self.addSubview(self.button)
+
+        let breathe = CABasicAnimation(keyPath: "shadowRadius")
+        breathe.fromValue = 16.0 as NSNumber
+        breathe.toValue = 28.0 as NSNumber
+        breathe.duration = 2.4
+        breathe.autoreverses = true
+        breathe.repeatCount = .infinity
+        breathe.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
+        breathe.isRemovedOnCompletion = false
+        self.logoView.layer.add(breathe, forKey: "breathe")
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    @objc private func buttonPressed() {
+        self.pressed?()
+    }
+
+    /// Lays out inside `band`, the part of the view free of side insets.
+    func update(size: CGSize, band: CGRect, bottomInset: CGFloat) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        defer { CATransaction.commit() }
+
+        let logoSize = min(160.0, band.width * 0.42)
+        let logoFrame = CGRect(x: band.midX - logoSize / 2.0, y: max(90.0, floor(size.height * 0.19)), width: logoSize, height: logoSize)
+        self.logoView.frame = logoFrame
+
+        let logoLightSize = logoSize * 2.6
+        self.logoLightLayer.frame = CGRect(x: logoFrame.midX - logoLightSize / 2.0, y: logoFrame.midY - logoLightSize / 2.0, width: logoLightSize, height: logoLightSize)
+
+        let lightSize = max(size.width, size.height) * 0.95
+        self.lightLayer.frame = CGRect(x: band.midX - lightSize / 2.0, y: size.height * 0.62 - lightSize / 2.0, width: lightSize, height: lightSize)
+
+        let textWidth = band.width - 48.0
+        let subtitleSize = self.subtitleLabel.sizeThatFits(CGSize(width: textWidth, height: 200.0))
+        let titleSize = self.titleLabel.sizeThatFits(CGSize(width: textWidth, height: 80.0))
+        let spacing: CGFloat = 26.0
+        self.textContainer.frame = CGRect(x: band.minX + 24.0, y: logoFrame.maxY + 34.0, width: textWidth, height: subtitleSize.height + spacing + titleSize.height)
+        self.subtitleLabel.frame = CGRect(x: 0.0, y: 0.0, width: textWidth, height: subtitleSize.height)
+        self.titleLabel.frame = CGRect(x: 0.0, y: subtitleSize.height + spacing, width: textWidth, height: titleSize.height)
+
+        self.button.frame = CGRect(x: band.minX + 21.0, y: size.height - max(bottomInset, 16.0) - 16.0 - 50.0, width: band.width - 42.0, height: 50.0)
+    }
+
+    func animateIn() {
+        self.logoView.layer.animateScale(from: 0.82, to: 1.0, duration: 0.5, timingFunction: kCAMediaTimingFunctionSpring)
+        for layer in [self.logoView.layer, self.textContainer.layer, self.button.layer, self.lightLayer, self.logoLightLayer] {
+            layer.animateAlpha(from: 0.0, to: 1.0, duration: 0.35)
+        }
+    }
+
+    var logoSnapshot: UIView? {
+        let snapshot = self.logoView.snapshotView(afterScreenUpdates: false)
+        snapshot?.frame = self.logoView.frame
+        return snapshot
+    }
+
+    var textSnapshot: UIView? {
+        let snapshot = self.textContainer.snapshotView(afterScreenUpdates: false)
+        snapshot?.frame = self.textContainer.frame
+        return snapshot
+    }
+}
