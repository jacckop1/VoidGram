+
+/// Whether this is a wallpaper the user picked rather than a theme's default: a photo (VoidGram's
+/// own wallpapers are saved as photos too), or a file that isn't one of the built-in patterns.
+func ayuIsChosenWallpaper(_ wallpaper: TelegramWallpaper) -> Bool {
+    switch wallpaper {
+    case .image:
+        return true
+    case let .file(file):
+        let builtin: [BuiltinWallpaperData] = [.default, .legacy, .variant1, .variant2, .variant3, .variant4, .variant5, .variant6, .variant7, .variant8, .variant9]
+        return !builtin.contains(where: { $0.slug == file.slug })
+    default:
+        return false
+    }
+}
