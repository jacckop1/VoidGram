+/// The light behind a reaction: its usual colour for the common emoji, otherwise the bubble's.
+private func ayuReactionGlowColor(_ reaction: MessageReaction.Reaction, fallback: UIColor) -> UIColor {
+    switch reaction {
+    case let .builtin(value):
+        let emoji = value.replacingOccurrences(of: "\u{fe0f}", with: "")
+        switch emoji {
+        case "❤", "💋", "🍓", "💔", "🌹", "🤬", "😡":
+            return UIColor(rgb: 0xFF2D3B)
+        case "🔥", "🎃", "🍾", "😁":
+            return UIColor(rgb: 0xFF8A1F)
+        case "👍", "👎", "⚡", "🌟", "🏆", "🤩", "🎉", "😂", "🤣", "💯", "🍌":
+            return UIColor(rgb: 0xFFCC33)
+        case "💘", "🥰", "😍", "😘", "💅", "🦄":
+            return UIColor(rgb: 0xFF4FA3)
+        case "🐳", "🥶", "🌚", "👻", "🕊":
+            return UIColor(rgb: 0x4FB7FF)
+        case "💩", "🤔", "🙏", "🤝", "👀":
+            return UIColor(rgb: 0xC9A37A)
+        default:
+            return fallback
+        }
+    case .stars:
+        return UIColor(rgb: 0xFFBE27)
+    case .custom:
+        return fallback
+    }
+}
