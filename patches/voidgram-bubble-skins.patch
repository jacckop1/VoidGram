@@ -0,0 +1,217 @@
+import Foundation
+import UIKit
+import Display
+
+/// VoidGram bubble skins.
+///
+/// `badge`: the grey VoidGram skin, a gradient with the VoidGram mark repeated over it, for
+/// everyone with a badge the owner gave (not a timed one from the daily roulette).
+/// `owner`: the same skin in a gold frame, for the project's owner.
+public enum AyuBubbleSkin: Equatable {
+    case badge(dark: Bool)
+    case owner(dark: Bool)
+
+    var dark: Bool {
+        switch self {
+        case let .badge(dark), let .owner(dark):
+            return dark
+        }
+    }
+
+    var isOwner: Bool {
+        if case .owner = self {
+            return true
+        }
+        return false
+    }
+}
+
+/// The skin's images, shipped in the app bundle (assets/bubbles in the VoidGram repository) and
+/// decoded once. The gradient is drawn by Core Animation; only a 64 pt pattern tile and the
+/// frame's 9-slice and ornaments are bitmaps, so a bubble of any size costs the same.
+private enum AyuBubbleSkinAssets {
+    static func load(_ name: String) -> UIImage? {
+        return Bundle.main.path(forResource: name, ofType: "png").flatMap(UIImage.init(contentsOfFile:))
+    }
+
+    static let frame = load("VoidGramBubbleFrame@3x")
+    static let ornamentTop = load("VoidGramBubbleFrameTop@3x")
+    static let ornamentBottom = load("VoidGramBubbleFrameBottom@3x")
+    static let pattern = load("VoidGramBubblePattern@3x")
+
+    /// The white tile as a pattern colour, light or dark.
+    static let lightPattern: CGColor? = pattern.map { UIColor(patternImage: $0).cgColor }
+    static let darkPattern: CGColor? = pattern.flatMap { image -> CGColor? in
+        let format = UIGraphicsImageRendererFormat()
+        format.scale = image.scale
+        let tinted = UIGraphicsImageRenderer(size: image.size, format: format).image { _ in
+            image.draw(at: .zero)
+            UIColor.black.setFill()
+            UIRectFillUsingBlendMode(CGRect(origin: .zero, size: image.size), .sourceIn)
+        }
+        return UIColor(patternImage: tinted).cgColor
+    }
+}
+
+/// The skin's layers inside a bubble background: the masked fill, and for the owner the frame.
+/// Every frame comes from `frames(imageFrame:)`, so layout and the send animation move all of
+/// them exactly as the bubble image moves.
+final class AyuBubbleSkinLayers {
+    private let fill = CALayer()
+    private let fillMask = CALayer()
+    private let shapeMask = CALayer()
+    private let bodyMask = CALayer()
+    private let gradient = CAGradientLayer()
+    private let pattern = CALayer()
+    private let frame = CALayer()
+    private let ornamentTop = CALayer()
+    private let ornamentBottom = CALayer()
+
+    private var skin: AyuBubbleSkin?
+    private var incoming = false
+
+    /// Frame thickness and its outset beyond the bubble's body, in points.
+    private static let frameOutset: CGFloat = 3.0
+    private static let frameThickness: CGFloat = 7.0
+    /// The bubble image's transparent margin and its tail column (messageBubbleImage).
+    private static let imageInset: CGFloat = 2.0
+    private static let tailWidth: CGFloat = 6.0
+
+    init() {
+        self.fillMask.addSublayer(self.shapeMask)
+        self.fillMask.addSublayer(self.bodyMask)
+        self.fill.mask = self.fillMask
+        self.fill.addSublayer(self.gradient)
+        self.fill.addSublayer(self.pattern)
+
+        self.bodyMask.backgroundColor = UIColor.white.cgColor
+        self.bodyMask.cornerRadius = 2.0
+
+        self.gradient.startPoint = CGPoint(x: 1.0, y: 0.0)
+        self.gradient.endPoint = CGPoint(x: 0.0, y: 1.0)
+
+        for layer in [self.frame, self.ornamentTop, self.ornamentBottom] {
+            layer.contentsScale = 3.0
+            layer.contentsGravity = .resize
+        }
+        self.frame.contents = AyuBubbleSkinAssets.frame?.cgImage
+        if let image = AyuBubbleSkinAssets.frame, let cgImage = image.cgImage {
+            // Corners stay whole, the 2 px plain strips between them stretch.
+            let width = CGFloat(cgImage.width), height = CGFloat(cgImage.height)
+            let capX = floor((width - 2.0) / 2.0), capY = floor((height - 2.0) / 2.0)
+            self.frame.contentsCenter = CGRect(x: capX / width, y: capY / height, width: 2.0 / width, height: 2.0 / height)
+        }
+        self.ornamentTop.contents = AyuBubbleSkinAssets.ornamentTop?.cgImage
+        self.ornamentBottom.contents = AyuBubbleSkinAssets.ornamentBottom?.cgImage
+    }
+
+    private var allLayers: [CALayer] {
+        return [self.fill, self.frame, self.ornamentTop, self.ornamentBottom]
+    }
+
+    func insert(into parent: CALayer, above sibling: CALayer) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        parent.insertSublayer(self.fill, above: sibling)
+        parent.insertSublayer(self.frame, above: self.fill)
+        parent.insertSublayer(self.ornamentTop, above: self.frame)
+        parent.insertSublayer(self.ornamentBottom, above: self.ornamentTop)
+        CATransaction.commit()
+    }
+
+    func removeFromSuperlayer() {
+        for layer in self.allLayers {
+            layer.removeFromSuperlayer()
+        }
+    }
+
+    func update(skin: AyuBubbleSkin, shape: UIImage, incoming: Bool, highlighted: Bool) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        defer { CATransaction.commit() }
+
+        self.skin = skin
+        self.incoming = incoming
+
+        self.shapeMask.contents = shape.cgImage
+        self.shapeMask.contentsScale = shape.scale
+        let size = shape.size, insets = shape.capInsets
+        if size.width > 0.0, size.height > 0.0 {
+            self.shapeMask.contentsCenter = CGRect(x: insets.left / size.width, y: insets.top / size.height, width: max(0.0, size.width - insets.left - insets.right) / size.width, height: max(0.0, size.height - insets.top - insets.bottom) / size.height)
+        }
+
+        if skin.dark {
+            // Sampled from the reference skin: near-black top right, warm grey bottom left.
+            self.gradient.colors = [UIColor(rgb: 0x060606).cgColor, UIColor(rgb: 0x2A2927).cgColor, UIColor(rgb: 0x737069).cgColor]
+            self.pattern.backgroundColor = AyuBubbleSkinAssets.lightPattern
+            self.pattern.opacity = 0.07
+        } else {
+            self.gradient.colors = [UIColor(rgb: 0xF4F3F1).cgColor, UIColor(rgb: 0xE4E2DF).cgColor, UIColor(rgb: 0xC9C6C1).cgColor]
+            self.pattern.backgroundColor = AyuBubbleSkinAssets.darkPattern
+            self.pattern.opacity = 0.06
+        }
+        self.gradient.locations = [0.0, 0.45, 1.0]
+
+        // The theme's own highlight shows through while the bubble is pressed.
+        self.fill.opacity = highlighted ? 0.75 : 1.0
+
+        let owner = skin.isOwner && AyuBubbleSkinAssets.frame != nil
+        self.bodyMask.isHidden = !owner
+        self.frame.isHidden = !owner
+        self.ornamentTop.isHidden = !owner
+        self.ornamentBottom.isHidden = !owner
+    }
+
+    /// Every skin layer's frame for a bubble image at `imageFrame`.
+    private func frames(imageFrame: CGRect) -> (frames: [(CALayer, CGRect)], roomForOrnaments: Bool) {
+        let bounds = CGRect(origin: .zero, size: imageFrame.size)
+        var body = bounds.insetBy(dx: AyuBubbleSkinLayers.imageInset, dy: AyuBubbleSkinLayers.imageInset)
+        body.size.width = max(0.0, body.width - AyuBubbleSkinLayers.tailWidth)
+        if self.incoming {
+            body.origin.x += AyuBubbleSkinLayers.tailWidth
+        }
+        let frameRect = body.offsetBy(dx: imageFrame.minX, dy: imageFrame.minY).insetBy(dx: -AyuBubbleSkinLayers.frameOutset, dy: -AyuBubbleSkinLayers.frameOutset)
+        // The fill reaches under the frame's square inner corners, past the bubble's round ones.
+        let innerInset = AyuBubbleSkinLayers.frameThickness - AyuBubbleSkinLayers.frameOutset - 0.5
+        let bodyMaskFrame = body.insetBy(dx: innerInset, dy: innerInset)
+
+        var result: [(CALayer, CGRect)] = [
+            (self.fill, imageFrame),
+            (self.fillMask, bounds),
+            (self.shapeMask, bounds),
+            (self.bodyMask, bodyMaskFrame),
+            (self.gradient, bounds),
+            (self.pattern, bounds),
+            (self.frame, frameRect)
+        ]
+        let ornamentSize = CGSize(width: 62.0 / 3.0, height: 36.0 / 3.0)
+        let roomForOrnaments = frameRect.width >= ornamentSize.width + 48.0
+        let ornamentX = floor(frameRect.midX - ornamentSize.width / 2.0)
+        result.append((self.ornamentTop, CGRect(origin: CGPoint(x: ornamentX, y: frameRect.minY), size: ornamentSize)))
+        result.append((self.ornamentBottom, CGRect(origin: CGPoint(x: ornamentX, y: frameRect.maxY - ornamentSize.height), size: ornamentSize)))
+        return (result, roomForOrnaments)
+    }
+
+    /// Moves every layer to its frame for `imageFrame`, each through `apply` (the caller's
+    /// transition). Implicit animations are off: a skin layer moves only as the bubble does.
+    func layout(imageFrame: CGRect, apply: (CALayer, CGRect) -> Void) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        let (frames, roomForOrnaments) = self.frames(imageFrame: imageFrame)
+        for (layer, frame) in frames {
+            apply(layer, frame)
+        }
+        let showsFrame = (self.skin?.isOwner ?? false) && AyuBubbleSkinAssets.frame != nil
+        self.ornamentTop.isHidden = !(showsFrame && roomForOrnaments)
+        self.ornamentBottom.isHidden = !(showsFrame && roomForOrnaments)
+        CATransaction.commit()
+    }
+
+    /// The send animation: every layer starts where it would be for the input field's frame.
+    func animate(from sourceFrame: CGRect, animateFrame: (CALayer, CGRect) -> Void) {
+        for (layer, from) in self.frames(imageFrame: sourceFrame).frames {
+            animateFrame(layer, from)
+        }
+        self.fill.animateAlpha(from: 0.0, to: CGFloat(self.fill.opacity), duration: 0.1)
+    }
+}
