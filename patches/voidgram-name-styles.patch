new file mode 100644
index 00000000..7e770405
--- /dev/null
+++ b/submodules/Display/Source/AyuNameStyling.swift
@@ -0,0 +1,55 @@
+import Foundation
+import UIKit
+
+/// A sponsor's name style on a name that is already laid out as an attributed string: the font
+/// variant and colour they chose. `variant` is 0 regular, 1 bold, 2 italic, 3 monospace and 4
+/// monospace italic.
+public enum AyuNameStyling {
+    public static func font(_ base: UIFont, variant: Int) -> UIFont {
+        let size = base.pointSize
+        switch variant {
+        case 1:
+            return UIFont.systemFont(ofSize: size, weight: .bold)
+        case 2:
+            return UIFont.italicSystemFont(ofSize: size)
+        case 3:
+            return UIFont.monospacedSystemFont(ofSize: size, weight: .medium)
+        case 4:
+            // SF Mono has no italic, so the upright letters are slanted by 14 degrees.
+            let mono = UIFont.monospacedSystemFont(ofSize: size, weight: .medium)
+            let slant = CGAffineTransform(a: 1.0, b: 0.0, c: CGFloat(tan(14.0 * Double.pi / 180.0)), d: 1.0, tx: 0.0, ty: 0.0)
+            return UIFont(descriptor: mono.fontDescriptor.withMatrix(slant), size: size)
+        default:
+            return base
+        }
+    }
+
+    public static func apply(to string: NSAttributedString, variant: Int, color: UInt32?) -> NSAttributedString {
+        if string.length == 0 || (variant == 0 && color == nil) {
+            return string
+        }
+        let result = NSMutableAttributedString(attributedString: string)
+        let full = NSRange(location: 0, length: result.length)
+        result.enumerateAttribute(.font, in: full, options: [], using: { value, range, _ in
+            if let base = value as? UIFont {
+                result.addAttribute(.font, value: font(base, variant: variant), range: range)
+            }
+        })
+        if let color {
+            result.addAttribute(.foregroundColor, value: UIColor(rgb: color), range: full)
+        }
+        return result
+    }
+
+    /// The light a glowing name gives off, on the layer that draws it.
+    public static func setGlow(on layer: CALayer, color: UInt32?) {
+        if let color {
+            layer.shadowColor = UIColor(rgb: color).cgColor
+            layer.shadowOpacity = 0.9
+            layer.shadowRadius = 5.0
+            layer.shadowOffset = .zero
+        } else {
+            layer.shadowOpacity = 0.0
+        }
+    }
+}
