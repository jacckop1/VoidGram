diff --git a/submodules/Display/Source/AyuAvatarFrames.swift b/submodules/Display/Source/AyuAvatarFrames.swift
new file mode 100644
index 00000000..a3978746
--- /dev/null
+++ b/submodules/Display/Source/AyuAvatarFrames.swift
@@ -0,0 +1,159 @@
+import Foundation
+import UIKit
+import ImageIO
+
+/// VoidGram's avatar frames: looping transparent PNGs on the badge server, downloaded once. The
+/// server's catalog says which exist, so new ones need no app update.
+public enum AyuAvatarFrames {
+    public struct Entry: Equatable {
+        public let id: String
+        public let titleRu: String
+        public let titleEn: String
+    }
+
+    /// The avatar's clear circle fills this part of a frame's width.
+    public static let avatarFraction: CGFloat = 178.0 / 240.0
+
+    private static let baseUrl = "https://badge.vinx.best/assets/frames/"
+
+    fileprivate final class Decoded {
+        let images: [CGImage]
+        let duration: Double
+
+        init(images: [CGImage], duration: Double) {
+            self.images = images
+            self.duration = duration
+        }
+    }
+
+    private static let memory = NSCache<NSString, Decoded>()
+    private static let queue = DispatchQueue(label: "voidgram.avatarFrames", qos: .userInitiated)
+
+    private static func isValid(id: String) -> Bool {
+        return !id.isEmpty && id.count <= 40 && id.allSatisfy { $0.isASCII && ($0.isLowercase || $0.isNumber || $0 == "_" || $0 == "-") }
+    }
+
+    public static func catalog(completion: @escaping ([Entry]) -> Void) {
+        guard let url = URL(string: baseUrl + "catalog.json") else {
+            completion([])
+            return
+        }
+        let request = URLRequest(url: url, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 20.0)
+        URLSession.shared.dataTask(with: request, completionHandler: { data, _, _ in
+            var result: [Entry] = []
+            if let data, let json = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any], let frames = json["frames"] as? [[String: Any]] {
+                for frame in frames {
+                    if let id = frame["id"] as? String, isValid(id: id) {
+                        result.append(Entry(id: id, titleRu: frame["ru"] as? String ?? id, titleEn: frame["en"] as? String ?? id))
+                    }
+                }
+            }
+            DispatchQueue.main.async {
+                completion(result)
+            }
+        }).resume()
+    }
+
+    private static func decode(data: Data) -> Decoded? {
+        guard let source = CGImageSourceCreateWithData(data as CFData, nil) else {
+            return nil
+        }
+        var images: [CGImage] = []
+        var duration = 0.0
+        let count = min(CGImageSourceGetCount(source), 120)
+        for index in 0 ..< count {
+            guard let image = CGImageSourceCreateImageAtIndex(source, index, nil) else {
+                continue
+            }
+            images.append(image)
+            let properties = CGImageSourceCopyPropertiesAtIndex(source, index, nil) as? [CFString: Any]
+            let png = properties?[kCGImagePropertyPNGDictionary] as? [CFString: Any]
+            let delay = (png?[kCGImagePropertyAPNGUnclampedDelayTime] as? Double) ?? (png?[kCGImagePropertyAPNGDelayTime] as? Double) ?? 0.07
+            duration += max(0.02, delay)
+        }
+        return images.isEmpty ? nil : Decoded(images: images, duration: duration)
+    }
+
+    fileprivate static func load(id: String, completion: @escaping (Decoded?) -> Void) {
+        guard isValid(id: id), let url = URL(string: baseUrl + id + ".png") else {
+            completion(nil)
+            return
+        }
+        if let decoded = memory.object(forKey: id as NSString) {
+            completion(decoded)
+            return
+        }
+        let finish: (Data) -> Void = { data in
+            queue.async {
+                let decoded = decode(data: data)
+                if let decoded {
+                    memory.setObject(decoded, forKey: id as NSString)
+                }
+                DispatchQueue.main.async {
+                    completion(decoded)
+                }
+            }
+        }
+        let directory = FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0].appendingPathComponent("voidgram-avatar-frames", isDirectory: true)
+        let file = directory.appendingPathComponent(id + ".png")
+        queue.async {
+            if let data = try? Data(contentsOf: file) {
+                finish(data)
+                return
+            }
+            URLSession.shared.dataTask(with: url, completionHandler: { data, response, _ in
+                guard let data, (response as? HTTPURLResponse)?.statusCode == 200 else {
+                    DispatchQueue.main.async {
+                        completion(nil)
+                    }
+                    return
+                }
+                try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+                try? data.write(to: file, options: .atomic)
+                finish(data)
+            }).resume()
+        }
+    }
+}
+
+/// Plays one avatar frame. The parent sets its frame.
+public final class AyuAvatarFrameView: UIView {
+    public private(set) var frameId: String?
+
+    public override init(frame: CGRect) {
+        super.init(frame: frame)
+        self.isUserInteractionEnabled = false
+        self.layer.contentsGravity = .resizeAspect
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    public func setFrameId(_ id: String?) {
+        if self.frameId == id {
+            return
+        }
+        self.frameId = id
+        self.layer.removeAnimation(forKey: "frames")
+        self.layer.contents = nil
+        guard let id else {
+            return
+        }
+        AyuAvatarFrames.load(id: id, completion: { [weak self] decoded in
+            guard let self, self.frameId == id, let decoded else {
+                return
+            }
+            self.layer.contents = decoded.images.first
+            if decoded.images.count > 1 {
+                let animation = CAKeyframeAnimation(keyPath: "contents")
+                animation.values = decoded.images
+                animation.calculationMode = .discrete
+                animation.duration = decoded.duration
+                animation.repeatCount = .infinity
+                animation.isRemovedOnCompletion = false
+                self.layer.add(animation, forKey: "frames")
+            }
+        })
+    }
+}
diff --git a/submodules/SettingsUI/Sources/AyuAvatarFramePicker.swift b/submodules/SettingsUI/Sources/AyuAvatarFramePicker.swift
new file mode 100644
index 00000000..d75232ed
--- /dev/null
+++ b/submodules/SettingsUI/Sources/AyuAvatarFramePicker.swift
@@ -0,0 +1,161 @@
+import Foundation
+import UIKit
+import Display
+import SwiftSignalKit
+import TelegramCore
+import AccountContext
+
+/// A sponsor's choice of avatar frame: every frame in the server's catalog, playing around a circle.
+/// The choice goes to the badge server, so everyone on VoidGram sees it in the profile.
+private final class AyuAvatarFramePickerController: UIViewController, UICollectionViewDataSource, UICollectionViewDelegateFlowLayout {
+    private final class Cell: UICollectionViewCell {
+        let frameView = AyuAvatarFrameView()
+        let circle = UIView()
+        let title = UILabel()
+
+        override init(frame: CGRect) {
+            super.init(frame: frame)
+            self.circle.backgroundColor = UIColor(white: 0.5, alpha: 0.35)
+            self.contentView.addSubview(self.circle)
+            self.contentView.addSubview(self.frameView)
+            self.title.font = Font.regular(13.0)
+            self.title.textAlignment = .center
+            self.contentView.addSubview(self.title)
+        }
+
+        required init?(coder: NSCoder) {
+            fatalError("init(coder:) has not been implemented")
+        }
+
+        override func layoutSubviews() {
+            super.layoutSubviews()
+            let side = self.contentView.bounds.width
+            self.frameView.frame = CGRect(x: 0.0, y: 0.0, width: side, height: side)
+            let avatar = side * AyuAvatarFrames.avatarFraction
+            self.circle.frame = CGRect(x: (side - avatar) / 2.0, y: (side - avatar) / 2.0, width: avatar, height: avatar)
+            self.circle.layer.cornerRadius = avatar / 2.0
+            self.title.frame = CGRect(x: 0.0, y: side, width: side, height: 20.0)
+        }
+    }
+
+    private let context: AccountContext
+    private let ru: Bool
+    private var entries: [AyuAvatarFrames.Entry] = []
+    private var selected: String?
+    private var isSaving = false
+    private let disposable = MetaDisposable()
+    private var collectionView: UICollectionView?
+
+    init(context: AccountContext, ru: Bool) {
+        self.context = context
+        self.ru = ru
+        self.selected = AyuSupportersManager.shared.avatarFrame(peerId: context.account.peerId.id._internalGetInt64Value())
+        super.init(nibName: nil, bundle: nil)
+        self.title = ru ? "Рамка аватарки" : "Avatar frame"
+        self.navigationItem.leftBarButtonItem = UIBarButtonItem(title: ru ? "Закрыть" : "Close", style: .plain, target: self, action: #selector(self.closePressed))
+        self.navigationItem.rightBarButtonItem = UIBarButtonItem(title: ru ? "Снять" : "Remove", style: .plain, target: self, action: #selector(self.removePressed))
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    deinit {
+        self.disposable.dispose()
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        self.view.backgroundColor = .systemBackground
+        let collectionView = UICollectionView(frame: self.view.bounds, collectionViewLayout: UICollectionViewFlowLayout())
+        collectionView.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        collectionView.backgroundColor = .clear
+        collectionView.dataSource = self
+        collectionView.delegate = self
+        collectionView.register(Cell.self, forCellWithReuseIdentifier: "frame")
+        self.view.addSubview(collectionView)
+        self.collectionView = collectionView
+
+        AyuAvatarFrames.catalog(completion: { [weak self] entries in
+            guard let self else {
+                return
+            }
+            self.entries = entries
+            self.collectionView?.reloadData()
+            if entries.isEmpty {
+                self.show(self.ru ? "Не удалось загрузить рамки." : "Could not load the frames.")
+            }
+        })
+    }
+
+    @objc private func closePressed() {
+        self.dismiss(animated: true)
+    }
+
+    @objc private func removePressed() {
+        self.save(nil)
+    }
+
+    private func show(_ text: String) {
+        let alert = UIAlertController(title: "VoidGram", message: text, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: "OK", style: .default))
+        self.present(alert, animated: true)
+    }
+
+    private func save(_ id: String?) {
+        guard !self.isSaving else {
+            return
+        }
+        self.isSaving = true
+        let body: [String: Any] = ["frame": id.map { $0 as Any } ?? (NSNull() as Any)]
+        self.disposable.set((AyuBadgeServer.post(account: self.context.account, route: "frame", body: body, ru: self.ru)
+        |> deliverOnMainQueue).startStrict(next: { [weak self] _ in
+            guard let self else {
+                return
+            }
+            self.isSaving = false
+            self.selected = id
+            self.dismiss(animated: true)
+        }, error: { [weak self] text in
+            guard let self else {
+                return
+            }
+            self.isSaving = false
+            self.show(text)
+        }))
+    }
+
+    func collectionView(_ collectionView: UICollectionView, numberOfItemsInSection section: Int) -> Int {
+        return self.entries.count
+    }
+
+    func collectionView(_ collectionView: UICollectionView, cellForItemAt indexPath: IndexPath) -> UICollectionViewCell {
+        let cell = collectionView.dequeueReusableCell(withReuseIdentifier: "frame", for: indexPath) as! Cell
+        let entry = self.entries[indexPath.item]
+        cell.frameView.setFrameId(entry.id)
+        cell.title.text = self.ru ? entry.titleRu : entry.titleEn
+        cell.title.textColor = entry.id == self.selected ? UIColor.systemBlue : UIColor.label
+        return cell
+    }
+
+    func collectionView(_ collectionView: UICollectionView, layout collectionViewLayout: UICollectionViewLayout, sizeForItemAt indexPath: IndexPath) -> CGSize {
+        let side = floor((collectionView.bounds.width - 16.0 * 2.0 - 8.0 * 2.0) / 3.0)
+        return CGSize(width: side, height: side + 26.0)
+    }
+
+    func collectionView(_ collectionView: UICollectionView, layout collectionViewLayout: UICollectionViewLayout, insetForSectionAt section: Int) -> UIEdgeInsets {
+        return UIEdgeInsets(top: 16.0, left: 16.0, bottom: 16.0, right: 16.0)
+    }
+
+    func collectionView(_ collectionView: UICollectionView, layout collectionViewLayout: UICollectionViewLayout, minimumInteritemSpacingForSectionAt section: Int) -> CGFloat {
+        return 8.0
+    }
+
+    func collectionView(_ collectionView: UICollectionView, didSelectItemAt indexPath: IndexPath) {
+        self.save(self.entries[indexPath.item].id)
+    }
+}
+
+func ayuAvatarFramePicker(context: AccountContext, ru: Bool) -> UIViewController {
+    return UINavigationController(rootViewController: AyuAvatarFramePickerController(context: context, ru: ru))
+}
