diff --git a/Telegram/cmake/voidgram_mac_icon.cmake b/Telegram/cmake/voidgram_mac_icon.cmake
new file mode 100644
index 0000000..216d9db
--- /dev/null
+++ b/Telegram/cmake/voidgram_mac_icon.cmake
@@ -0,0 +1,29 @@
+set(iconset "${ICON_OUTPUT}.iconset")
+file(MAKE_DIRECTORY "${iconset}")
+foreach(size 16 32 128 256 512)
+    foreach(scale 1 2)
+        math(EXPR pixels "${size} * ${scale}")
+        if(scale EQUAL 2)
+            set(suffix "@2x")
+        else()
+            set(suffix "")
+        endif()
+        execute_process(
+            COMMAND "${SIPS}" -z ${pixels} ${pixels} "${ICON_SOURCE}"
+                --out "${iconset}/icon_${size}x${size}${suffix}.png"
+            RESULT_VARIABLE status
+            OUTPUT_QUIET
+        )
+        if(NOT status EQUAL 0)
+            message(FATAL_ERROR "Cannot resize ${ICON_SOURCE}: ${status}")
+        endif()
+    endforeach()
+endforeach()
+execute_process(
+    COMMAND "${ICONUTIL}" --convert icns --output "${ICON_OUTPUT}" "${iconset}"
+    RESULT_VARIABLE status
+)
+if(NOT status EQUAL 0)
+    message(FATAL_ERROR "Cannot create ${ICON_OUTPUT}: ${status}")
+endif()
+file(REMOVE_RECURSE "${iconset}")
