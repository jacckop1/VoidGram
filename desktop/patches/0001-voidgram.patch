@@ -0,0 +1,462 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_frames.h"
+
+#include <QtCore/QDateTime>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QPointer>
+#include <QtCore/QStandardPaths>
+#include <QtCore/QTimer>
+#include <QtGui/QPainter>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+#include <zlib.h>
+
+#include <algorithm>
+#include <cmath>
+#include <map>
+
+namespace VoidGram {
+namespace {
+
+constexpr auto kBaseUrl = "https://badge.vinx.best/assets/frames/";
+constexpr auto kBaseWidth = 240.;
+constexpr auto kMaxFrames = 120;
+constexpr auto kMaxSide = 1200;
+constexpr qint64 kRefetchAfterSecs = 24 * 60 * 60;
+
+struct Chunk {
+	QByteArray type;
+	QByteArray data;
+};
+
+[[nodiscard]] quint32 ReadBE32(const QByteArray &bytes, int offset) {
+	const auto p = reinterpret_cast<const unsigned char*>(bytes.constData()) + offset;
+	return (quint32(p[0]) << 24) | (quint32(p[1]) << 16) | (quint32(p[2]) << 8) | quint32(p[3]);
+}
+
+[[nodiscard]] quint32 ReadBE16(const QByteArray &bytes, int offset) {
+	const auto p = reinterpret_cast<const unsigned char*>(bytes.constData()) + offset;
+	return (quint32(p[0]) << 8) | quint32(p[1]);
+}
+
+void AppendBE32(QByteArray &to, quint32 value) {
+	to.append(char(value >> 24));
+	to.append(char(value >> 16));
+	to.append(char(value >> 8));
+	to.append(char(value));
+}
+
+void AppendChunk(QByteArray &to, const char *type, const QByteArray &data) {
+	AppendBE32(to, quint32(data.size()));
+	auto body = QByteArray(type, 4);
+	body.append(data);
+	to.append(body);
+	const auto crc = crc32(
+		0,
+		reinterpret_cast<const Bytef*>(body.constData()),
+		uInt(body.size()));
+	AppendBE32(to, quint32(crc));
+}
+
+[[nodiscard]] std::optional<std::vector<Chunk>> ReadChunks(const QByteArray &data) {
+	static const auto kSignature = QByteArray("\x89PNG\r\n\x1a\n", 8);
+	if (data.size() < 8 + 12 || !data.startsWith(kSignature)) {
+		return std::nullopt;
+	}
+	auto result = std::vector<Chunk>();
+	auto offset = 8;
+	while (offset + 12 <= data.size()) {
+		const auto length = qint64(ReadBE32(data, offset));
+		if (offset + 12 + length > data.size()) {
+			return std::nullopt;
+		}
+		result.push_back({
+			.type = data.mid(offset + 4, 4),
+			.data = data.mid(offset + 8, int(length)),
+		});
+		offset += int(12 + length);
+		if (result.back().type == "IEND") {
+			break;
+		}
+	}
+	return result;
+}
+
+struct FrameControl {
+	int width = 0;
+	int height = 0;
+	int x = 0;
+	int y = 0;
+	int delayMs = 100;
+	int dispose = 0;
+	int blend = 0;
+};
+
+[[nodiscard]] std::optional<FrameControl> ReadFrameControl(const QByteArray &data) {
+	if (data.size() < 26) {
+		return std::nullopt;
+	}
+	auto result = FrameControl();
+	result.width = int(ReadBE32(data, 4));
+	result.height = int(ReadBE32(data, 8));
+	result.x = int(ReadBE32(data, 12));
+	result.y = int(ReadBE32(data, 16));
+	const auto num = int(ReadBE16(data, 20));
+	auto den = int(ReadBE16(data, 22));
+	if (!den) {
+		den = 100;
+	}
+	result.delayMs = std::max(20, (num * 1000) / den);
+	result.dispose = uchar(data[24]);
+	result.blend = uchar(data[25]);
+	return result;
+}
+
+[[nodiscard]] QString CacheFolder() {
+	const auto base = QStandardPaths::writableLocation(QStandardPaths::CacheLocation);
+	if (base.isEmpty()) {
+		return QString();
+	}
+	const auto result = base + "/voidgram-frames";
+	QDir().mkpath(result);
+	return result;
+}
+
+[[nodiscard]] bool ValidId(const QString &id) {
+	if (id.isEmpty() || id.size() > 40) {
+		return false;
+	}
+	for (const auto ch : id) {
+		const auto ok = (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '_' || ch == '-';
+		if (!ok) {
+			return false;
+		}
+	}
+	return true;
+}
+
+[[nodiscard]] QNetworkAccessManager &Network() {
+	static auto result = QNetworkAccessManager();
+	return result;
+}
+
+[[nodiscard]] std::map<QString, std::shared_ptr<AnimatedFrame>> &Memory() {
+	static auto result = std::map<QString, std::shared_ptr<AnimatedFrame>>();
+	return result;
+}
+
+} // namespace
+
+double AnimatedFrame::extent() const {
+	return std::clamp(size.width() / kBaseWidth, 1., 3.);
+}
+
+std::shared_ptr<AnimatedFrame> DecodeApng(const QByteArray &data) {
+	const auto chunks = ReadChunks(data);
+	if (!chunks) {
+		return nullptr;
+	}
+	auto header = QByteArray();
+	auto prefix = std::vector<Chunk>(); // PLTE, tRNS and the like, copied into every frame.
+	auto count = 0;
+	for (const auto &chunk : *chunks) {
+		if (chunk.type == "IHDR") {
+			header = chunk.data;
+		} else if (chunk.type == "acTL") {
+			if (chunk.data.size() >= 8) {
+				count = int(ReadBE32(chunk.data, 0));
+			}
+		} else if (chunk.type == "PLTE" || chunk.type == "tRNS" || chunk.type == "gAMA"
+			|| chunk.type == "sRGB" || chunk.type == "cHRM" || chunk.type == "iCCP") {
+			prefix.push_back(chunk);
+		}
+	}
+	if (header.size() != 13 || count < 1) {
+		return nullptr;
+	}
+	const auto canvasWidth = int(ReadBE32(header, 0));
+	const auto canvasHeight = int(ReadBE32(header, 4));
+	if (canvasWidth < 1 || canvasHeight < 1 || canvasWidth > kMaxSide || canvasHeight > kMaxSide) {
+		return nullptr;
+	}
+
+	struct Raw {
+		FrameControl control;
+		QByteArray idat;
+	};
+	auto raws = std::vector<Raw>();
+	auto current = std::optional<FrameControl>();
+	auto idat = QByteArray();
+	const auto flush = [&] {
+		if (current && !idat.isEmpty()) {
+			raws.push_back({ *current, idat });
+		}
+		idat.clear();
+		current.reset();
+	};
+	for (const auto &chunk : *chunks) {
+		if (chunk.type == "fcTL") {
+			flush();
+			current = ReadFrameControl(chunk.data);
+		} else if (chunk.type == "IDAT") {
+			// IDAT belongs to the animation only when an fcTL came before it.
+			if (current) {
+				idat.append(chunk.data);
+			}
+		} else if (chunk.type == "fdAT") {
+			if (current && chunk.data.size() > 4) {
+				idat.append(chunk.data.mid(4));
+			}
+		}
+	}
+	flush();
+	if (raws.empty() || int(raws.size()) > kMaxFrames) {
+		return nullptr;
+	}
+
+	auto result = std::make_shared<AnimatedFrame>();
+	result->size = QSize(canvasWidth, canvasHeight);
+	auto canvas = QImage(result->size, QImage::Format_ARGB32_Premultiplied);
+	canvas.fill(Qt::transparent);
+	for (const auto &raw : raws) {
+		const auto &control = raw.control;
+		if (control.width < 1 || control.height < 1
+			|| control.x < 0 || control.y < 0
+			|| control.x + control.width > canvasWidth
+			|| control.y + control.height > canvasHeight) {
+			return nullptr;
+		}
+		auto frameHeader = header;
+		auto widthBytes = QByteArray();
+		auto heightBytes = QByteArray();
+		AppendBE32(widthBytes, quint32(control.width));
+		AppendBE32(heightBytes, quint32(control.height));
+		frameHeader.replace(0, 4, widthBytes);
+		frameHeader.replace(4, 4, heightBytes);
+
+		auto png = QByteArray("\x89PNG\r\n\x1a\n", 8);
+		AppendChunk(png, "IHDR", frameHeader);
+		for (const auto &chunk : prefix) {
+			AppendChunk(png, chunk.type.constData(), chunk.data);
+		}
+		AppendChunk(png, "IDAT", raw.idat);
+		AppendChunk(png, "IEND", QByteArray());
+
+		auto piece = QImage();
+		if (!piece.loadFromData(png, "PNG") || piece.isNull()) {
+			return nullptr;
+		}
+		piece = piece.convertToFormat(QImage::Format_ARGB32_Premultiplied);
+
+		const auto region = QRect(control.x, control.y, control.width, control.height);
+		const auto previous = (control.dispose == 2) ? canvas.copy() : QImage();
+		{
+			auto p = QPainter(&canvas);
+			p.setCompositionMode(control.blend == 0
+				? QPainter::CompositionMode_Source
+				: QPainter::CompositionMode_SourceOver);
+			p.drawImage(region.topLeft(), piece);
+		}
+		result->images.push_back(canvas.copy());
+		result->delaysMs.push_back(control.delayMs);
+		result->totalMs += control.delayMs;
+
+		if (control.dispose == 1) {
+			auto p = QPainter(&canvas);
+			p.setCompositionMode(QPainter::CompositionMode_Source);
+			p.fillRect(region, Qt::transparent);
+		} else if (control.dispose == 2 && !previous.isNull()) {
+			canvas = previous;
+		}
+	}
+	return result;
+}
+
+void LoadFrame(
+		const QString &id,
+		Fn<void(std::shared_ptr<AnimatedFrame>)> done) {
+	if (!ValidId(id)) {
+		done(nullptr);
+		return;
+	}
+	auto &memory = Memory();
+	if (const auto i = memory.find(id); i != memory.end()) {
+		done(i->second);
+		return;
+	}
+	const auto folder = CacheFolder();
+	const auto path = folder.isEmpty() ? QString() : folder + "/" + id + ".png";
+	auto cached = QByteArray();
+	auto fresh = false;
+	if (!path.isEmpty()) {
+		auto file = QFile(path);
+		if (file.open(QIODevice::ReadOnly)) {
+			cached = file.readAll();
+			const auto age = QFileInfo(path).lastModified().secsTo(QDateTime::currentDateTime());
+			fresh = (age >= 0 && age < kRefetchAfterSecs);
+		}
+	}
+	const auto finish = [=](const QByteArray &bytes) {
+		const auto decoded = DecodeApng(bytes);
+		if (decoded) {
+			Memory()[id] = decoded;
+		}
+		done(decoded);
+	};
+	if (!cached.isEmpty() && fresh) {
+		finish(cached);
+		return;
+	}
+	auto request = QNetworkRequest(QUrl(QString::fromLatin1(kBaseUrl) + id + ".png"));
+	request.setAttribute(
+		QNetworkRequest::CacheLoadControlAttribute,
+		QNetworkRequest::AlwaysNetwork);
+	request.setTransferTimeout(20 * 1000);
+	const auto reply = Network().get(request);
+	QObject::connect(reply, &QNetworkReply::finished, [=] {
+		reply->deleteLater();
+		const auto ok = (reply->error() == QNetworkReply::NoError);
+		const auto bytes = ok ? reply->readAll() : QByteArray();
+		if (!bytes.isEmpty() && DecodeApng(bytes)) {
+			if (!path.isEmpty()) {
+				auto file = QFile(path);
+				if (file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+					file.write(bytes);
+				}
+			}
+			finish(bytes);
+		} else if (!cached.isEmpty()) {
+			// Offline: the old copy stays in use.
+			finish(cached);
+		} else {
+			done(nullptr);
+		}
+	});
+}
+
+void LoadCatalog(Fn<void(std::vector<FrameEntry>)> done) {
+	auto request = QNetworkRequest(QUrl(QString::fromLatin1(kBaseUrl) + "catalog.json"));
+	request.setAttribute(
+		QNetworkRequest::CacheLoadControlAttribute,
+		QNetworkRequest::AlwaysNetwork);
+	request.setTransferTimeout(20 * 1000);
+	const auto reply = Network().get(request);
+	QObject::connect(reply, &QNetworkReply::finished, [=] {
+		reply->deleteLater();
+		auto result = std::vector<FrameEntry>();
+		if (reply->error() == QNetworkReply::NoError) {
+			const auto root = QJsonDocument::fromJson(reply->readAll()).object();
+			for (const auto &value : root.value("frames").toArray()) {
+				const auto object = value.toObject();
+				const auto id = object.value("id").toString();
+				if (ValidId(id)) {
+					result.push_back({
+						.id = id,
+						.titleRu = object.value("ru").toString(id),
+						.titleEn = object.value("en").toString(id),
+					});
+				}
+			}
+		}
+		done(std::move(result));
+	});
+}
+
+FrameWidget::FrameWidget(QWidget *parent)
+: RpWidget(parent) {
+	setAttribute(Qt::WA_TransparentForMouseEvents);
+	setAttribute(Qt::WA_TranslucentBackground);
+	_timer = new QTimer(this);
+	_timer->setSingleShot(true);
+	QObject::connect(_timer, &QTimer::timeout, this, [=] { tick(); });
+}
+
+void FrameWidget::setFrame(const QString &id) {
+	if (_id == id) {
+		return;
+	}
+	_id = id;
+	_frame = nullptr;
+	_index = 0;
+	_timer->stop();
+	_extentChanged.fire({});
+	if (id.isEmpty()) {
+		update();
+		return;
+	}
+	const auto weak = QPointer<FrameWidget>(this);
+	LoadFrame(id, [=](std::shared_ptr<AnimatedFrame> frame) {
+		if (!weak || weak->_id != id || !frame) {
+			return;
+		}
+		weak->_frame = std::move(frame);
+		weak->_index = 0;
+		weak->placeAround(weak->_avatar);
+		weak->update();
+		weak->_extentChanged.fire({});
+		if (weak->_frame->images.size() > 1) {
+			weak->_timer->start(weak->_frame->delaysMs[0]);
+		}
+	});
+}
+
+void FrameWidget::setUserScale(double scale) {
+	_userScale = std::clamp(scale, 0.5, 1.6);
+	placeAround(_avatar);
+}
+
+void FrameWidget::setFitsInside(bool fits) {
+	_fitsInside = fits;
+	placeAround(_avatar);
+}
+
+double FrameWidget::extent() const {
+	return _frame ? _frame->extent() : 1.;
+}
+
+rpl::producer<> FrameWidget::extentChanged() const {
+	return _extentChanged.events();
+}
+
+void FrameWidget::placeAround(QRect avatar) {
+	_avatar = avatar;
+	if (avatar.isEmpty()) {
+		return;
+	}
+	const auto scale = (_fitsInside ? 1. : extent()) * _userScale;
+	const auto side = int(std::round(avatar.width() / kAvatarFraction * scale));
+	const auto center = avatar.center();
+	setGeometry(
+		center.x() - side / 2,
+		center.y() - side / 2,
+		side,
+		side);
+}
+
+void FrameWidget::tick() {
+	if (!_frame || _frame->images.size() < 2) {
+		return;
+	}
+	_index = (_index + 1) % int(_frame->images.size());
+	update();
+	_timer->start(_frame->delaysMs[_index]);
+}
+
+void FrameWidget::paintEvent(QPaintEvent *e) {
+	if (!_frame || _frame->images.empty()) {
+		return;
+	}
+	auto p = QPainter(this);
+	p.setRenderHint(QPainter::SmoothPixmapTransform);
+	p.drawImage(rect(), _frame->images[_index]);
+}
+
+} // namespace VoidGram
