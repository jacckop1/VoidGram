+void LookBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto user = session->user();
+	const auto bareId = qint64(user->id.value & PeerId::kChatTypeMask);
+	const auto &registry = Registry::instance();
+	const auto entry = registry.find(bareId);
+
+	box->setTitle(rpl::single(Text("Рамка и ник", "Frame and name")));
+	if (!registry.isSponsor(bareId)) {
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(Text(
+				"Рамки и стили ника доступны спонсорам VoidGram.",
+				"Frames and name styles are for VoidGram sponsors.")),
+			st::boxLabel));
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+		return;
+	}
+
+	const auto state = std::make_shared<LookState>();
+	if (entry) {
+		state->frame = entry->frame;
+		state->scale = entry->frameScale;
+		if (entry->nameStyle) {
+			state->name = *entry->nameStyle;
+		}
+	}
+	const auto initialFrame = state->frame;
+	const auto initialScale = state->scale;
+	const auto initialName = state->name;
+
+	box->addRow(
+		object_ptr<Preview>(box, user, state),
+		style::margins(0, 0, 0, 0));
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			state->changed.events_starting_with({}) | rpl::map([=] {
+				return Text("Размер рамки: ", "Frame size: ")
+					+ QString::number(int(std::round(state->scale * 100)))
+					+ '%';
+			}),
+			st::boxLabel),
+		st::boxRowPadding);
+	const auto slider = box->addRow(
+		object_ptr<Ui::MediaSlider>(box, st::autoDownloadLimitSlider),
+		st::boxRowPadding);
+	slider->resize(st::autoDownloadLimitSlider.seekSize);
+	slider->setValue((state->scale - kMinScale) / (kMaxScale - kMinScale));
+	slider->setChangeProgressCallback([=](float64 value) {
+		state->scale = kMinScale + value * (kMaxScale - kMinScale);
+		state->changed.fire({});
+	});
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(Text("Ник", "Name")),
+			st::boxLabel),
+		st::boxRowPadding);
+	const auto group = std::make_shared<Ui::RadiobuttonGroup>(state->name.font);
+	const auto fonts = std::vector<QString>{
+		Text("Обычный", "Regular"),
+		Text("Жирный", "Bold"),
+		Text("Курсив", "Italic"),
+		Text("Моноширинный", "Monospace"),
+		Text("Моно, курсив", "Monospace italic"),
+	};
+	for (auto i = 0; i != int(fonts.size()); ++i) {
+		box->addRow(
+			object_ptr<Ui::Radiobutton>(
+				box,
+				group,
+				i,
+				fonts[i],
+				st::defaultBoxCheckbox),
+			st::boxRowPadding);
+	}
+	group->setChangedCallback([=](int value) {
+		state->name.font = value;
+		state->changed.fire({});
+	});
+	box->addRow(
+		object_ptr<SwatchRow>(box, state),
+		st::boxRowPadding);
+	const auto glow = box->addRow(
+		object_ptr<Ui::Checkbox>(
+			box,
+			Text("Свечение ника в профиле", "Name glow in the profile"),
+			state->name.glow,
+			st::defaultBoxCheckbox),
+		st::boxRowPadding);
+	glow->checkedChanges(
+	) | rpl::on_next([=](bool checked) {
+		state->name.glow = checked;
+		state->changed.fire({});
+	}, glow->lifetime());
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(Text("Рамка", "Frame")),
+			st::boxLabel),
+		st::boxRowPadding);
+	box->addRow(object_ptr<FrameGrid>(box, state), st::boxRowPadding);
+
+	const auto saving = std::make_shared<bool>(false);
+	const auto save = [=] {
+		if (*saving) {
+			return;
+		}
+		auto steps = std::vector<std::pair<QString, QJsonObject>>();
+		const auto roundedScale = std::round(state->scale * 100) / 100;
+		if (state->frame != initialFrame
+			|| (!state->frame.isEmpty() && std::abs(state->scale - initialScale) > 0.004)) {
+			auto body = QJsonObject();
+			body.insert("frame", state->frame.isEmpty()
+				? QJsonValue(QJsonValue::Null)
+				: QJsonValue(state->frame));
+			if (!state->frame.isEmpty()) {
+				body.insert("scale", roundedScale);
+			}
+			steps.emplace_back("frame", std::move(body));
+		}
+		const auto plain = state->name.plain() && !state->name.glow;
+		const auto initialPlain = initialName.plain() && !initialName.glow;
+		const auto same = (plain && initialPlain)
+			|| (!plain
+				&& !initialPlain
+				&& state->name.font == initialName.font
+				&& state->name.color == initialName.color
+				&& state->name.glow == initialName.glow);
+		if (!same) {
+			auto body = QJsonObject();
+			body.insert("style", plain
+				? QJsonValue(QJsonValue::Null)
+				: QJsonValue(StyleToJson(state->name)));
+			steps.emplace_back("style", std::move(body));
+		}
+		if (steps.empty()) {
+			box->closeBox();
+			return;
+		}
+		*saving = true;
+		const auto shared = std::make_shared<decltype(steps)>(std::move(steps));
+		const auto run = std::make_shared<Fn<void(int)>>();
+		const auto weak = base::make_weak(box.get());
+		*run = [=](int index) {
+			if (index >= int(shared->size())) {
+				*saving = false;
+				if (const auto strong = weak.get()) {
+					strong->closeBox();
+				}
+				return;
+			}
+			Post(session, (*shared)[index].first, (*shared)[index].second, [=](QString error) {
+				if (!error.isEmpty()) {
+					*saving = false;
+					if (const auto strong = weak.get()) {
+						strong->showToast(error);
+					}
+					return;
+				}
+				(*run)(index + 1);
+			});
+		};
+		(*run)(0);
+	};
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	box->addLeftButton(
+		rpl::single(Text("Без рамки", "No frame")),
+		[=] {
+			state->frame = QString();
+			state->changed.fire({});
+		});
+}
+
+} // namespace VoidGram
