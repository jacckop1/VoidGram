+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_gifts.h"
+
+#include "data/components/gift_auctions.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "main/main_session.h"
+#include "voidgram/voidgram_registry.h"
+
+#include <set>
+
+namespace VoidGram {
+namespace {
+
+template <typename List>
+[[nodiscard]] const typename List::value_type *FindByName(
+		const List &list,
+		const QString &name) {
+	for (const auto &item : list) {
+		if (item.name.compare(name, Qt::CaseInsensitive) == 0) {
+			return &item;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] std::vector<Data::SavedStarGift> Build(
+		not_null<PeerData*> peer,
+		const Entry &entry) {
+	auto result = std::vector<Data::SavedStarGift>();
+	auto &auctions = peer->session().giftAuctions();
+	auto index = 0;
+	for (const auto &gift : entry.gifts) {
+		++index;
+		const auto attributes = auctions.attributes(gift.giftId);
+		if (!attributes) {
+			continue;
+		}
+		const auto model = FindByName(attributes->models, gift.model);
+		const auto pattern = FindByName(attributes->patterns, gift.pattern);
+		const auto backdrop = FindByName(attributes->backdrops, gift.backdrop);
+		if (!model || !pattern || !backdrop) {
+			continue;
+		}
+		auto slug = gift.title;
+		slug.remove(' ');
+		auto unique = std::make_shared<Data::UniqueGift>(Data::UniqueGift{
+			.id = gift.giftId ^ (quint64(gift.number) << 40) ^ quint64(entry.id),
+			.initialGiftId = gift.giftId,
+			.slug = slug + '-' + QString::number(gift.number),
+			.title = gift.title,
+			.ownerId = peer->id,
+			.number = gift.number,
+			.model = *model,
+			.pattern = *pattern,
+			.backdrop = *backdrop,
+		});
+		auto info = Data::StarGift{
+			.id = gift.giftId,
+			.unique = std::move(unique),
+			.document = model->document,
+		};
+		result.push_back(Data::SavedStarGift{
+			.info = std::move(info),
+			.manageId = Data::SavedStarGiftId::User(
+				MsgId(0x7F000000 + index)),
+			.message = TextWithEntities{ gift.text },
+			.date = TimeId(gift.date),
+			.pinned = !gift.unpinned,
+		});
+	}
+	return result;
+}
+
+} // namespace
+
+void LoadGrantedGifts(
+		not_null<PeerData*> peer,
+		Fn<void(std::vector<Data::SavedStarGift>)> done) {
+	const auto entry = Registry::instance().find(
+		qint64(peer->id.value & PeerId::kChatTypeMask));
+	if (!entry || entry->gifts.empty()) {
+		done({});
+		return;
+	}
+	const auto bareId = entry->id;
+	const auto weak = base::make_weak(&peer->session());
+	const auto peerId = peer->id;
+	auto ids = std::set<quint64>();
+	for (const auto &gift : entry->gifts) {
+		ids.insert(gift.giftId);
+	}
+	const auto pending = std::make_shared<int>(int(ids.size()));
+	const auto finish = [=] {
+		const auto session = weak.get();
+		if (!session) {
+			return;
+		}
+		const auto strong = session->data().peer(peerId);
+		const auto now = Registry::instance().find(bareId);
+		done(now ? Build(strong, *now) : std::vector<Data::SavedStarGift>());
+	};
+	auto &auctions = peer->session().giftAuctions();
+	for (const auto id : ids) {
+		if (auctions.attributes(id)) {
+			if (!--*pending) {
+				finish();
+			}
+			continue;
+		}
+		auctions.requestAttributes(id, [=] {
+			if (!--*pending) {
+				finish();
+			}
+		});
+	}
+}
+
+} // namespace VoidGram
