+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonObject>
+
+namespace VoidGram {
+namespace {
+
+[[nodiscard]] QString Text(const char *ru, const char *en) {
+	return Lang::Id().startsWith(u"ru"_q)
+		? QString::fromUtf8(ru)
+		: QString::fromUtf8(en);
+}
+
+[[nodiscard]] qint64 SelfId(not_null<Window::SessionController*> controller) {
+	return qint64(controller->session().user()->id.value & PeerId::kChatTypeMask);
+}
+
+[[nodiscard]] QString NanoToTon(qint64 nano) {
+	if (nano <= 0) {
+		return QString();
+	}
+	auto whole = QString::number(nano / 1000000000);
+	auto fraction = QString::number(nano % 1000000000).rightJustified(9, '0');
+	while (fraction.endsWith('0')) {
+		fraction.chop(1);
+	}
+	return fraction.isEmpty() ? whole : (whole + '.' + fraction);
+}
+
+} // namespace
+
+bool CanEditProfile(not_null<Window::SessionController*> controller) {
+	const auto id = SelfId(controller);
+	const auto &registry = Registry::instance();
+	if (id && id == registry.ownerId()) {
+		return true;
+	}
+	const auto entry = registry.find(id);
+	return entry && entry->selfEdit;
+}
+
+void ProfileBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto entry = Registry::instance().find(SelfId(controller));
+
+	box->setTitle(rpl::single(Text("Мой профиль VoidGram", "My VoidGram profile")));
+	if (!CanEditProfile(controller)) {
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(Text(
+				"Владелец ещё не разрешил вам менять профиль.",
+				"The owner has not let you change your profile yet.")),
+			st::boxLabel));
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+		return;
+	}
+	box->setWidth(st::boxWideWidth);
+
+	const auto cosmetics = (entry && entry->cosmetics)
+		? *entry->cosmetics
+		: Cosmetics();
+	const auto field = [&](QString label, QString value) {
+		return box->addRow(
+			object_ptr<Ui::InputField>(
+				box,
+				st::defaultInputField,
+				Ui::InputField::Mode::SingleLine,
+				rpl::single(label),
+				value),
+			st::boxRowPadding);
+	};
+	const auto title = field(
+		Text("Текст бейджа", "Badge text"),
+		entry ? entry->title : QString());
+	const auto usernames = field(
+		Text("Юзернеймы через запятую (до 5)", "Usernames, comma-separated (up to 5)"),
+		cosmetics.usernames.join(u", "_q));
+	const auto phone = field(
+		Text("Номер телефона (с кодом страны)", "Phone number (with country code)"),
+		cosmetics.phone);
+	const auto ton = field(
+		Text("Баланс TON", "TON balance"),
+		NanoToTon(cosmetics.tonNano));
+	const auto level = field(
+		Text("Уровень рейтинга (1–99)", "Rating level (1–99)"),
+		cosmetics.hasRating() ? QString::number(cosmetics.ratingLevel) : QString());
+	const auto stars = field(
+		Text("Звёзды рейтинга", "Rating stars"),
+		cosmetics.hasRating() ? QString::number(cosmetics.ratingStars) : QString());
+
+	const auto saving = std::make_shared<bool>(false);
+	const auto weak = base::make_weak(box.get());
+	box->addButton(tr::lng_settings_save(), [=] {
+		if (*saving) {
+			return;
+		}
+		auto change = QJsonObject();
+		const auto text = [](not_null<Ui::InputField*> f) {
+			return f->getLastText().trimmed();
+		};
+		const auto put = [&](const char *key, const QString &value) {
+			change.insert(
+				QString::fromLatin1(key),
+				value.isEmpty() ? QJsonValue(QJsonValue::Null) : QJsonValue(value));
+		};
+		put("title", text(title));
+		put("phone", text(phone));
+		put("ton", text(ton));
+		const auto names = text(usernames).split(
+			QRegularExpression(u"[,\\s]+"_q),
+			Qt::SkipEmptyParts);
+		if (names.isEmpty()) {
+			change.insert("usernames", QJsonValue(QJsonValue::Null));
+		} else {
+			auto array = QJsonArray();
+			for (const auto &name : names) {
+				array.push_back(name);
+			}
+			change.insert("usernames", array);
+		}
+		const auto levelText = text(level);
+		if (levelText.isEmpty()) {
+			change.insert("rating", QJsonValue(QJsonValue::Null));
+		} else {
+			auto rating = QJsonObject();
+			rating.insert("level", levelText.toInt());
+			rating.insert("stars", double(text(stars).toLongLong()));
+			change.insert("rating", rating);
+		}
+		auto body = QJsonObject();
+		body.insert("peerId", QString::number(SelfId(controller)));
+		body.insert("change", change);
+		*saving = true;
+		Post(session, u"admin"_q, body, [=](QString error) {
+			*saving = false;
+			const auto strong = weak.get();
+			if (!strong) {
+				return;
+			}
+			if (error.isEmpty()) {
+				strong->closeBox();
+			} else {
+				strong->showToast(error);
+			}
+		});
+	});
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+}
+
+} // namespace VoidGram
