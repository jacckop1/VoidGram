+
+#include <QtCore/QPointer>
+#include <QtWidgets/QGraphicsEffect>
+
+#include <cmath>
+
+namespace VoidGram {
+namespace {
+
+constexpr auto kMinScale = 0.5;
+constexpr auto kMaxScale = 1.6;
+constexpr auto kPreviewHeight = 230;
+constexpr auto kAvatarSize = 88;
+constexpr auto kSwatch = 28;
+
+const auto kColors = std::vector<std::optional<QColor>>{
+	std::nullopt,
+	QColor(0xFF, 0x45, 0x3A),
+	QColor(0xFF, 0x9F, 0x0A),
+	QColor(0xFF, 0xD6, 0x0A),
+	QColor(0x32, 0xD7, 0x4B),
+	QColor(0x64, 0xD2, 0xFF),
+	QColor(0x0A, 0x84, 0xFF),
+	QColor(0x8E, 0x5C, 0xF7),
+	QColor(0xFF, 0x6B, 0xD6),
+	QColor(0xFF, 0xFF, 0xFF),
+};
+
+[[nodiscard]] bool Russian() {
+	return Lang::Id().startsWith(u"ru"_q);
+}
+
+[[nodiscard]] QString Text(const char *ru, const char *en) {
+	return Russian() ? QString::fromUtf8(ru) : QString::fromUtf8(en);
+}
+
+// What is being chosen, shared by the preview and the controls.
+struct LookState {
+	QString frame;
+	double scale = 1.;
+	NameStyle name;
+	rpl::event_stream<> changed;
+};
+
+[[nodiscard]] QJsonObject StyleToJson(const NameStyle &style) {
+	auto result = QJsonObject();
+	result.insert("font", style.font);
+	if (style.color) {
+		result.insert("color", style.color->name(QColor::HexRgb).toUpper());
+	}
+	result.insert("glow", style.glow);
+	return result;
+}
+
+// The name, drawn with the chosen style; the glow is a shadow effect on this widget alone.
+class NameLabel final : public Ui::RpWidget {
+public:
+	NameLabel(QWidget *parent, QString name, std::shared_ptr<LookState> state)
+	: RpWidget(parent)
+	, _name(std::move(name))
+	, _state(std::move(state)) {
+		setAttribute(Qt::WA_TransparentForMouseEvents);
+		_state->changed.events(
+		) | rpl::on_next([=] {
+			refresh();
+		}, lifetime());
+		refresh();
+	}
+
+private:
+	void refresh() {
+		const auto plain = _state->name.plain() && !_state->name.glow;
+		const auto style = plain ? nullptr : &_state->name;
+		_text.setText(
+			StyledTextStyle(st::semiboldTextStyle, style),
+			_name,
+			Ui::NameTextOptions());
+		resize(std::max(_text.maxWidth(), 1) + st::boxRowPadding.left(), _text.minHeight() + 8);
+		if (_state->name.glow) {
+			const auto effect = new QGraphicsDropShadowEffect(this);
+			effect->setOffset(0, 0);
+			effect->setBlurRadius(14);
+			effect->setColor(_state->name.color.value_or(QColor(0x8E, 0x5C, 0xF7)));
+			setGraphicsEffect(effect);
+		} else {
+			setGraphicsEffect(nullptr);
+		}
+		update();
+	}
+
+	void paintEvent(QPaintEvent *e) override {
+		auto p = Painter(this);
+		p.setPen(_state->name.color.value_or(st::windowFg->c));
+		_text.draw(p, {
+			.position = { st::boxRowPadding.left() / 2, 4 },
+			.availableWidth = width(),
+			.elisionLines = 1,
+		});
+	}
+
+	QString _name;
+	std::shared_ptr<LookState> _state;
+	Ui::Text::String _text;
+
+};
+
+// The user's own avatar with the chosen frame around it.
+class Preview final : public Ui::RpWidget {
+public:
+	Preview(
+		QWidget *parent,
+		not_null<UserData*> user,
+		std::shared_ptr<LookState> state)
+	: RpWidget(parent)
+	, _user(user)
+	, _state(std::move(state))
+	, _frame(this)
+	, _label(this, user->name(), _state) {
+		resize(width(), kPreviewHeight);
+		user->session().downloaderTaskFinished(
+		) | rpl::on_next([=] {
+			update();
+		}, lifetime());
+		_frame.setUserScale(_state->scale);
+		_frame.setFrame(_state->frame);
+		_state->changed.events(
+		) | rpl::on_next([=] {
+			_frame.setUserScale(_state->scale);
+			_frame.setFrame(_state->frame);
+			layoutChildren();
+			update();
+		}, lifetime());
+		sizeValue(
+		) | rpl::on_next([=] {
+			layoutChildren();
+		}, lifetime());
+		_label.show();
+	}
+
+	int resizeGetHeight(int newWidth) override {
+		return kPreviewHeight;
+	}
+
+private:
+	[[nodiscard]] QRect avatarRect() const {
+		return QRect(
+			(width() - kAvatarSize) / 2,
+			(kPreviewHeight - 40 - kAvatarSize) / 2 + 4,
+			kAvatarSize,
+			kAvatarSize);
+	}
+
+	void layoutChildren() {
+		_frame.placeAround(avatarRect());
+		_frame.raise();
+		_label.move(
+			(width() - _label.width()) / 2,
+			kPreviewHeight - _label.height() - 4);
+	}
+
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		const auto rect = avatarRect();
+		_user->paintUserpic(p, _view, rect.x(), rect.y(), rect.width());
+	}
+
+	const not_null<UserData*> _user;
+	const std::shared_ptr<LookState> _state;
+	Ui::PeerUserpicView _view;
+	FrameWidget _frame;
+	NameLabel _label;
+
+};
+
+// One frame of the catalog, as a button.
+class FrameCell final : public Ui::AbstractButton {
+public:
+	FrameCell(QWidget *parent, FrameEntry entry, std::shared_ptr<LookState> state)
+	: AbstractButton(parent)
+	, _entry(std::move(entry))
+	, _look(std::move(state))
+	, _frame(this) {
+		_frame.setFitsInside(true);
+		_frame.setFrame(_entry.id);
+		_look->changed.events(
+		) | rpl::on_next([=] {
+			update();
+		}, lifetime());
+	}
+
+	void setSide(int side) {
+		resize(side, side + st::normalFont->height + 8);
+		_frame.placeAround(QRect(
+			(side - int(side * kAvatarFraction)) / 2,
+			(side - int(side * kAvatarFraction)) / 2,
+			int(side * kAvatarFraction),
+			int(side * kAvatarFraction)));
+		_frame.raise();
+	}
+
+private:
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		const auto side = width();
+		const auto chosen = (_look->frame == _entry.id);
+		p.setPen(Qt::NoPen);
+		p.setBrush(QColor(128, 128, 128, 90));
+		const auto avatar = int(side * kAvatarFraction) / _frame.extent();
+		p.setRenderHint(QPainter::Antialiasing);
+		p.drawEllipse(QRectF(
+			(side - avatar) / 2.,
+			(side - avatar) / 2.,
+			avatar,
+			avatar));
+		p.setPen(chosen ? st::windowActiveTextFg->c : st::windowFg->c);
+		p.setFont(st::normalFont);
+		p.drawText(
+			QRect(0, side, side, st::normalFont->height + 8),
+			Qt::AlignHCenter | Qt::AlignTop,
+			Russian() ? _entry.titleRu : _entry.titleEn);
+	}
+
+	const FrameEntry _entry;
+	const std::shared_ptr<LookState> _look;
+	FrameWidget _frame;
+
+};
+
+class FrameGrid final : public Ui::RpWidget {
+public:
+	FrameGrid(QWidget *parent, std::shared_ptr<LookState> state)
+	: RpWidget(parent)
+	, _state(std::move(state)) {
+		const auto weak = QPointer<FrameGrid>(this);
+		LoadCatalog([=](std::vector<FrameEntry> list) {
+			if (!weak) {
+				return;
+			}
+			weak->fill(std::move(list));
+		});
+	}
+
+	int resizeGetHeight(int newWidth) override {
+		const auto columns = 3;
+		const auto skip = 8;
+		const auto side = std::max((newWidth - skip * (columns - 1)) / columns, 40);
+		auto top = 0;
+		auto index = 0;
+		for (const auto &cell : _cells) {
+			const auto row = index / columns;
+			const auto column = index % columns;
+			cell->setSide(side);
+			cell->move(column * (side + skip), row * (cell->height() + skip));
+			top = std::max(top, cell->y() + cell->height());
+			++index;
+		}
+		return top;
+	}
+
+private:
+	void fill(std::vector<FrameEntry> list) {
+		for (auto &entry : list) {
+			const auto id = entry.id;
+			auto cell = std::make_unique<FrameCell>(this, std::move(entry), _state);
+			cell->setClickedCallback([=] {
+				_state->frame = id;
+				_state->changed.fire({});
+			});
+			cell->show();
+			_cells.push_back(std::move(cell));
+		}
+		resizeToWidth(width());
+		if (const auto parent = parentWidget()) {
+			parent->update();
+		}
+	}
+
+	const std::shared_ptr<LookState> _state;
+	std::vector<std::unique_ptr<FrameCell>> _cells;
+
+};
+
+class SwatchRow final : public Ui::RpWidget {
+public:
+	SwatchRow(QWidget *parent, std::shared_ptr<LookState> state)
+	: RpWidget(parent)
+	, _state(std::move(state)) {
+		resize(width(), kSwatch + 8);
+		_state->changed.events(
+		) | rpl::on_next([=] {
+			update();
+		}, lifetime());
+	}
+
+private:
+	[[nodiscard]] QRect swatchRect(int index) const {
+		const auto count = int(kColors.size());
+		const auto gap = (count > 1)
+			? std::max((width() - count * kSwatch) / (count - 1), 2)
+			: 0;
+		return QRect(index * (kSwatch + gap), 4, kSwatch, kSwatch);
+	}
+
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		p.setRenderHint(QPainter::Antialiasing);
+		for (auto i = 0; i != int(kColors.size()); ++i) {
+			const auto rect = swatchRect(i);
+			p.setPen(Qt::NoPen);
+			p.setBrush(kColors[i].value_or(QColor(128, 128, 128, 90)));
+			p.drawEllipse(rect);
+			const auto chosen = (kColors[i] == _state->name.color);
+			if (chosen) {
+				p.setBrush(Qt::NoBrush);
+				p.setPen(QPen(st::windowFg->c, 2));
+				p.drawEllipse(rect.adjusted(-3, -3, 3, 3));
+			}
+			if (!kColors[i]) {
+				p.setPen(st::windowFg->c);
+				p.drawText(rect, Qt::AlignCenter, QString::fromUtf8("∅"));
+			}
+		}
+	}
+
+	void mousePressEvent(QMouseEvent *e) override {
+		for (auto i = 0; i != int(kColors.size()); ++i) {
+			if (swatchRect(i).contains(e->pos())) {
+				_state->name.color = kColors[i];
+				_state->changed.fire({});
+				return;
+			}
+		}
+	}
+
+	const std::shared_ptr<LookState> _state;
+
+};
+
