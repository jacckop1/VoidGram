+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_glow.h"
+
+#include <QtGui/QRadialGradient>
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+namespace VoidGram {
+namespace {
+
+[[nodiscard]] QColor GlowColor(const QString &emoji) {
+	static const auto table = std::vector<std::pair<QString, QColor>>{
+		{ QString::fromUtf8("❤"), QColor(0xFF, 0x45, 0x3A) },
+		{ QString::fromUtf8("💯"), QColor(0xFF, 0x45, 0x3A) },
+		{ QString::fromUtf8("🔥"), QColor(0xFF, 0x9F, 0x0A) },
+		{ QString::fromUtf8("👍"), QColor(0xFF, 0xD6, 0x0A) },
+		{ QString::fromUtf8("😁"), QColor(0xFF, 0xD6, 0x0A) },
+		{ QString::fromUtf8("🤔"), QColor(0xFF, 0xD6, 0x0A) },
+		{ QString::fromUtf8("🙏"), QColor(0xFF, 0xD6, 0x0A) },
+		{ QString::fromUtf8("😍"), QColor(0xFF, 0x6B, 0xD6) },
+		{ QString::fromUtf8("🎉"), QColor(0xFF, 0x6B, 0xD6) },
+		{ QString::fromUtf8("🥰"), QColor(0xFF, 0x6B, 0xD6) },
+		{ QString::fromUtf8("😢"), QColor(0x64, 0xD2, 0xFF) },
+		{ QString::fromUtf8("👎"), QColor(0x64, 0xD2, 0xFF) },
+		{ QString::fromUtf8("🤮"), QColor(0x32, 0xD7, 0x4B) },
+		{ QString::fromUtf8("🤯"), QColor(0xBF, 0x5A, 0xF2) },
+	};
+	for (const auto &[key, color] : table) {
+		if (!key.isEmpty() && emoji.startsWith(key)) {
+			return color;
+		}
+	}
+	return QColor(0x8E, 0x5C, 0xF7);
+}
+
+} // namespace
+
+void PaintReactionGlow(
+		QPainter &p,
+		QRect rect,
+		const QString &emoji,
+		bool chosen) {
+	const auto center = QPointF(rect.center());
+	const auto radius = std::max(rect.width(), rect.height()) * 0.95;
+	auto color = GlowColor(emoji);
+	auto gradient = QRadialGradient(center, radius);
+	color.setAlphaF(chosen ? 0.55 : 0.34);
+	gradient.setColorAt(0., color);
+	color.setAlphaF(0.);
+	gradient.setColorAt(1., color);
+	p.save();
+	p.setPen(Qt::NoPen);
+	p.setBrush(gradient);
+	p.drawEllipse(center, radius, radius * 0.8);
+	p.restore();
+}
+
+} // namespace VoidGram
