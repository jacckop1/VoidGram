+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#pragma once
+
+#include <QtCore/QPoint>
+#include <QtCore/QRect>
+#include <QtCore/QString>
+#include <QtGui/QColor>
+#include <QtGui/QPainter>
+
+namespace VoidGram {
+
+// The light behind a reaction, in the colour of the reaction itself.
+void PaintReactionGlow(
+	QPainter &p,
+	QRect rect,
+	const QString &emoji,
+	bool chosen);
+
+// A name's glow: `draw` is called with a small shift several times, faintly, in the glow colour
+// (the pen is set to it), and the caller then draws the name itself on top.
+template <typename Draw>
+void PaintNameGlow(QPainter &p, const QColor &color, Draw &&draw) {
+	const auto opacity = p.opacity();
+	p.setPen(color);
+	p.setOpacity(opacity * 0.14);
+	const QPoint shifts[] = {
+		{ -2, 0 }, { 2, 0 }, { 0, -2 }, { 0, 2 },
+		{ -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 },
+		{ -3, 0 }, { 3, 0 }, { 0, -3 }, { 0, 3 },
+	};
+	for (const auto &shift : shifts) {
+		draw(shift);
+	}
+	p.setOpacity(opacity);
+}
+
+} // namespace VoidGram
