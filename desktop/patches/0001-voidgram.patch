+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_server.h"
+
+#include "apiwrap.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "voidgram/voidgram_registry.h"
+
+#include <QtCore/QJsonDocument>
+#include <QtCore/QUrl>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace VoidGram {
+namespace {
+
+constexpr auto kServer = "https://badge.vinx.best";
+constexpr auto kBotUsername = "AyuZayavka_bot";
+
+[[nodiscard]] QNetworkAccessManager &Network() {
+	static auto result = QNetworkAccessManager();
+	return result;
+}
+
+// The tgWebAppData parameter of the URL's fragment, a percent-encoded query string.
+[[nodiscard]] QString ExtractInitData(const QString &url) {
+	const auto hash = url.indexOf('#');
+	if (hash < 0) {
+		return QString();
+	}
+	const auto parts = url.mid(hash + 1).split('&', Qt::SkipEmptyParts);
+	for (const auto &part : parts) {
+		if (part.startsWith(u"tgWebAppData="_q)) {
+			return QUrl::fromPercentEncoding(part.mid(13).toUtf8());
+		}
+	}
+	return QString();
+}
+
+void RequestInitData(
+		not_null<Main::Session*> session,
+		Fn<void(QString initData, QString error)> done) {
+	const auto request = [=](not_null<UserData*> bot) {
+		using Flag = MTPmessages_RequestSimpleWebView::Flag;
+		session->api().request(MTPmessages_RequestSimpleWebView(
+			MTP_flags(Flag::f_url),
+			bot->inputUser(),
+			MTP_bytes(QByteArray(kServer) + "/"),
+			MTP_string(),
+			MTP_dataJSON(MTP_bytes()),
+			MTP_string(u"tdesktop"_q)
+		)).done([=](const MTPWebViewResult &result) {
+			const auto url = QString::fromUtf8(result.data().vurl().v);
+			auto initData = ExtractInitData(url);
+			if (initData.isEmpty()) {
+				done(QString(), u"NO_INIT_DATA"_q);
+			} else {
+				done(std::move(initData), QString());
+			}
+		}).fail([=](const MTP::Error &error) {
+			done(QString(), error.type());
+		}).send();
+	};
+	const auto username = QString::fromLatin1(kBotUsername);
+	if (const auto peer = session->data().peerByUsername(username)) {
+		if (const auto user = peer->asUser()) {
+			request(user);
+			return;
+		}
+	}
+	using Flag = MTPcontacts_ResolveUsername::Flag;
+	session->api().request(MTPcontacts_ResolveUsername(
+		MTP_flags(Flag()),
+		MTP_string(username),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		result.match([&](const MTPDcontacts_resolvedPeer &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			if (const auto peerId = peerFromMTP(data.vpeer())) {
+				if (const auto user = session->data().peer(peerId)->asUser()) {
+					request(user);
+					return;
+				}
+			}
+			done(QString(), u"BOT_NOT_FOUND"_q);
+		});
+	}).fail([=](const MTP::Error &error) {
+		done(QString(), error.type());
+	}).send();
+}
+
+} // namespace
+
+void Post(
+		not_null<Main::Session*> session,
+		const QString &route,
+		QJsonObject body,
+		Fn<void(QString error)> done) {
+	RequestInitData(session, [=](QString initData, QString error) mutable {
+		if (!error.isEmpty()) {
+			done(u"Telegram gave no sign-in data for the badge server (%1). Check that @%2 is not blocked."_q
+				.arg(error, QString::fromLatin1(kBotUsername)));
+			return;
+		}
+		auto copy = body;
+		copy.insert("initData", initData);
+		auto request = QNetworkRequest(QUrl(QString::fromLatin1(kServer) + "/api/" + route));
+		request.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+		request.setTransferTimeout(30 * 1000);
+		const auto reply = Network().post(
+			request,
+			QJsonDocument(copy).toJson(QJsonDocument::Compact));
+		QObject::connect(reply, &QNetworkReply::finished, [=] {
+			reply->deleteLater();
+			const auto status = reply->attribute(
+				QNetworkRequest::HttpStatusCodeAttribute).toInt();
+			const auto json = QJsonDocument::fromJson(reply->readAll()).object();
+			if (status == 200
+				&& json.contains("registry")
+				&& json.contains("signature")) {
+				if (Registry::instance().accept(
+						json.value("registry").toString().toUtf8(),
+						json.value("signature").toString().toUtf8(),
+						true)) {
+					done(QString());
+				} else {
+					done(u"The badge server's answer failed the signature check."_q);
+				}
+				return;
+			}
+			const auto text = json.value("error").toString();
+			done(text.isEmpty()
+				? (status
+					? u"The badge server answered %1."_q.arg(status)
+					: reply->errorString())
+				: text);
+		});
+	});
+}
+
+} // namespace VoidGram
