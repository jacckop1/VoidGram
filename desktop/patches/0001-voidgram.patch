+#pragma once
+
+#include "base/basic_types.h"
+
+#include <QtCore/QJsonObject>
+#include <QtCore/QString>
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace VoidGram {
+
+// Sends a change to the badge server (POST /api/<route>). The request proves who sent it with
+// Mini App data Telegram signs for the server's bot, so the client keeps no keys. The registry the
+// server answers with is signed; it is checked and taken into use before `done` is called with an
+// empty text, or with a message to show.
+void Post(
+	not_null<Main::Session*> session,
+	const QString &route,
+	QJsonObject body,
+	Fn<void(QString error)> done);
+
+} // namespace VoidGram
