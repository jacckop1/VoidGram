+
+// One frame of the catalog, as a button.
+class FrameCell final : public Ui::AbstractButton {
+public:
+	FrameCell(QWidget *parent, FrameEntry entry, std::shared_ptr<LookState> state)
+	: AbstractButton(parent)
+	, _entry(std::move(entry))
+	, _look(std::move(state))
+	, _frame(this) {
+		_frame.setFitsInside(true);
+		_frame.setFrame(_entry.id);
+		_look->changed.events(
+		) | rpl::on_next([=] {
+			update();
+		}, lifetime());
+	}
+
+	void setSide(int side) {
+		resize(side, side + st::normalFont->height + 8);
+		_frame.placeAround(QRect(
+			(side - int(side * kAvatarFraction)) / 2,
+			(side - int(side * kAvatarFraction)) / 2,
+			int(side * kAvatarFraction),
+			int(side * kAvatarFraction)));
+		_frame.raise();
+	}
+
+private:
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		const auto side = width();
+		const auto chosen = (_look->frame == _entry.id);
+		p.setPen(Qt::NoPen);
+		p.setBrush(QColor(128, 128, 128, 90));
+		const auto avatar = int(side * kAvatarFraction) / _frame.extent();
+		p.setRenderHint(QPainter::Antialiasing);
+		p.drawEllipse(QRectF(
+			(side - avatar) / 2.,
+			(side - avatar) / 2.,
+			avatar,
+			avatar));
+		p.setPen(chosen ? st::windowActiveTextFg->c : st::windowFg->c);
+		p.setFont(st::normalFont);
+		p.drawText(
+			QRect(0, side, side, st::normalFont->height + 8),
+			Qt::AlignHCenter | Qt::AlignTop,
+			Russian() ? _entry.titleRu : _entry.titleEn);
+	}
+
+	const FrameEntry _entry;
+	const std::shared_ptr<LookState> _look;
+	FrameWidget _frame;
+
+};
+
+class FrameGrid final : public Ui::RpWidget {
+public:
+	FrameGrid(QWidget *parent, std::shared_ptr<LookState> state)
+	: RpWidget(parent)
+	, _state(std::move(state)) {
+		const auto weak = QPointer<FrameGrid>(this);
+		LoadCatalog([=](std::vector<FrameEntry> list) {
+			if (!weak) {
+				return;
+			}
+			weak->fill(std::move(list));
+		});
+	}
+
+	int resizeGetHeight(int newWidth) override {
+		const auto columns = 3;
+		const auto skip = 8;
+		const auto side = std::max((newWidth - skip * (columns - 1)) / columns, 40);
+		auto top = 0;
+		auto index = 0;
+		for (const auto &cell : _cells) {
+			const auto row = index / columns;
+			const auto column = index % columns;
+			cell->setSide(side);
+			cell->move(column * (side + skip), row * (cell->height() + skip));
+			top = std::max(top, cell->y() + cell->height());
+			++index;
+		}
+		return top;
+	}
+
+private:
+	void fill(std::vector<FrameEntry> list) {
+		for (auto &entry : list) {
+			const auto id = entry.id;
+			auto cell = std::make_unique<FrameCell>(this, std::move(entry), _state);
+			cell->setClickedCallback([=] {
+				_state->frame = id;
+				_state->changed.fire({});
+			});
+			cell->show();
+			_cells.push_back(std::move(cell));
+		}
+		resizeToWidth(width());
+		if (const auto parent = parentWidget()) {
+			parent->update();
+		}
+	}
+
+	const std::shared_ptr<LookState> _state;
+	std::vector<std::unique_ptr<FrameCell>> _cells;
+
+};
+
+class SwatchRow final : public Ui::RpWidget {
+public:
+	SwatchRow(QWidget *parent, std::shared_ptr<LookState> state)
+	: RpWidget(parent)
+	, _state(std::move(state)) {
+		resize(width(), kSwatch + 8);
+		_state->changed.events(
+		) | rpl::on_next([=] {
+			update();
+		}, lifetime());
+	}
+
+private:
+	[[nodiscard]] QRect swatchRect(int index) const {
+		const auto count = int(kColors.size());
+		const auto gap = (count > 1)
+			? std::max((width() - count * kSwatch) / (count - 1), 2)
+			: 0;
+		return QRect(index * (kSwatch + gap), 4, kSwatch, kSwatch);
+	}
+
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		p.setRenderHint(QPainter::Antialiasing);
+		for (auto i = 0; i != int(kColors.size()); ++i) {
+			const auto rect = swatchRect(i);
+			p.setPen(Qt::NoPen);
+			p.setBrush(kColors[i].value_or(QColor(128, 128, 128, 90)));
+			p.drawEllipse(rect);
+			const auto chosen = (kColors[i] == _state->name.color);
+			if (chosen) {
+				p.setBrush(Qt::NoBrush);
+				p.setPen(QPen(st::windowFg->c, 2));
+				p.drawEllipse(rect.adjusted(-3, -3, 3, 3));
+			}
+			if (!kColors[i]) {
+				p.setPen(st::windowFg->c);
+				p.drawText(rect, Qt::AlignCenter, QString::fromUtf8("∅"));
+			}
+		}
+	}
+
+	void mousePressEvent(QMouseEvent *e) override {
+		for (auto i = 0; i != int(kColors.size()); ++i) {
+			if (swatchRect(i).contains(e->pos())) {
+				_state->name.color = kColors[i];
+				_state->changed.fire({});
+				return;
+			}
+		}
+	}
+
+	const std::shared_ptr<LookState> _state;
+
+};
+
+} // namespace
+
+void LookBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto user = session->user();
+	const auto bareId = qint64(user->id.value & PeerId::kChatTypeMask);
+	const auto &registry = Registry::instance();
+	const auto entry = registry.find(bareId);
+
+	box->setTitle(rpl::single(Text("Рамка и ник", "Frame and name")));
+	if (!registry.isSponsor(bareId)) {
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(Text(
+				"Рамки и стили ника доступны спонсорам VoidGram.",
+				"Frames and name styles are for VoidGram sponsors.")),
+			st::boxLabel));
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+		return;
+	}
+
+	const auto state = std::make_shared<LookState>();
+	if (entry) {
+		state->frame = entry->frame;
+		state->scale = entry->frameScale;
+		if (entry->nameStyle) {
+			state->name = *entry->nameStyle;
+		}
+	}
+	const auto initialFrame = state->frame;
+	const auto initialScale = state->scale;
+	const auto initialName = state->name;
+
+	box->addRow(
+		object_ptr<Preview>(box, user, state),
+		style::margins(0, 0, 0, 0));
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			state->changed.events_starting_with({}) | rpl::map([=] {
+				return Text("Размер рамки: ", "Frame size: ")
+					+ QString::number(int(std::round(state->scale * 100)))
+					+ '%';
+			}),
+			st::boxLabel),
+		st::boxRowPadding);
+	const auto slider = box->addRow(
+		object_ptr<Ui::MediaSlider>(box, st::autoDownloadLimitSlider),
+		st::boxRowPadding);
+	slider->resize(st::autoDownloadLimitSlider.seekSize);
+	slider->setValue((state->scale - kMinScale) / (kMaxScale - kMinScale));
+	slider->setChangeProgressCallback([=](float64 value) {
+		state->scale = kMinScale + value * (kMaxScale - kMinScale);
+		state->changed.fire({});
+	});
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(Text("Ник", "Name")),
+			st::boxLabel),
+		st::boxRowPadding);
+	const auto group = std::make_shared<Ui::RadiobuttonGroup>(state->name.font);
+	const auto fonts = std::vector<QString>{
+		Text("Обычный", "Regular"),
+		Text("Жирный", "Bold"),
+		Text("Курсив", "Italic"),
+		Text("Моноширинный", "Monospace"),
+		Text("Моно, курсив", "Monospace italic"),
+	};
+	for (auto i = 0; i != int(fonts.size()); ++i) {
+		box->addRow(
+			object_ptr<Ui::Radiobutton>(
+				box,
+				group,
+				i,
+				fonts[i],
+				st::defaultBoxCheckbox),
+			st::boxRowPadding);
+	}
+	group->setChangedCallback([=](int value) {
+		state->name.font = value;
+		state->changed.fire({});
+	});
+	box->addRow(
+		object_ptr<SwatchRow>(box, state),
+		st::boxRowPadding);
+	const auto glow = box->addRow(
+		object_ptr<Ui::Checkbox>(
+			box,
+			Text("Свечение ника в профиле", "Name glow in the profile"),
+			state->name.glow,
+			st::defaultBoxCheckbox),
+		st::boxRowPadding);
+	glow->checkedChanges(
+	) | rpl::on_next([=](bool checked) {
+		state->name.glow = checked;
+		state->changed.fire({});
+	}, glow->lifetime());
+
+	box->addRow(
+		object_ptr<Ui::FlatLabel>(
+			box,
+			rpl::single(Text("Рамка", "Frame")),
+			st::boxLabel),
+		st::boxRowPadding);
+	box->addRow(object_ptr<FrameGrid>(box, state), st::boxRowPadding);
+
+	const auto saving = std::make_shared<bool>(false);
+	const auto save = [=] {
+		if (*saving) {
+			return;
+		}
+		auto steps = std::vector<std::pair<QString, QJsonObject>>();
+		const auto roundedScale = std::round(state->scale * 100) / 100;
+		if (state->frame != initialFrame
+			|| (!state->frame.isEmpty() && std::abs(state->scale - initialScale) > 0.004)) {
+			auto body = QJsonObject();
+			body.insert("frame", state->frame.isEmpty()
+				? QJsonValue(QJsonValue::Null)
+				: QJsonValue(state->frame));
+			if (!state->frame.isEmpty()) {
+				body.insert("scale", roundedScale);
+			}
+			steps.emplace_back("frame", std::move(body));
+		}
+		const auto plain = state->name.plain() && !state->name.glow;
+		const auto initialPlain = initialName.plain() && !initialName.glow;
+		const auto same = (plain && initialPlain)
+			|| (!plain
+				&& !initialPlain
+				&& state->name.font == initialName.font
+				&& state->name.color == initialName.color
+				&& state->name.glow == initialName.glow);
+		if (!same) {
+			auto body = QJsonObject();
+			body.insert("style", plain
+				? QJsonValue(QJsonValue::Null)
+				: QJsonValue(StyleToJson(state->name)));
+			steps.emplace_back("style", std::move(body));
+		}
+		if (steps.empty()) {
+			box->closeBox();
+			return;
+		}
+		*saving = true;
+		const auto shared = std::make_shared<decltype(steps)>(std::move(steps));
+		const auto run = std::make_shared<Fn<void(int)>>();
+		const auto weak = base::make_weak(box.get());
+		*run = [=](int index) {
+			if (index >= int(shared->size())) {
+				*saving = false;
+				if (const auto strong = weak.get()) {
+					strong->closeBox();
+				}
+				return;
+			}
+			Post(session, (*shared)[index].first, (*shared)[index].second, [=](QString error) {
+				if (!error.isEmpty()) {
+					*saving = false;
+					if (const auto strong = weak.get()) {
+						strong->showToast(error);
+					}
+					return;
+				}
+				(*run)(index + 1);
+			});
+		};
+		(*run)(0);
+	};
+	box->addButton(tr::lng_settings_save(), save);
+	box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	box->addLeftButton(
+		rpl::single(Text("Без рамки", "No frame")),
+		[=] {
+			state->frame = QString();
+			state->changed.fire({});
+		});
+}
+
+} // namespace VoidGram
