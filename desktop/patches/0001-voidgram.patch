+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#pragma once
+
+#include "base/basic_types.h"
+#include "data/data_star_gift.h"
+
+namespace VoidGram {
+
+// The unique gifts (NFTs) the VoidGram owner gave this profile, as saved gifts of the profile, to
+// list beside its real ones. Each one needs its gift's models, patterns and backdrops, which
+// Telegram gives by gift; `done` gets the gifts that could be built, possibly none.
+void LoadGrantedGifts(
+	not_null<PeerData*> peer,
+	Fn<void(std::vector<Data::SavedStarGift>)> done);
+
+} // namespace VoidGram
