diff --git a/Telegram/SourceFiles/voidgram/voidgram_registry.cpp b/Telegram/SourceFiles/voidgram/voidgram_registry.cpp
new file mode 100644
index 0000000..f6b0ccc
--- /dev/null
+++ b/Telegram/SourceFiles/voidgram/voidgram_registry.cpp
@@ -0,0 +1,315 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_registry.h"
+
+#include "base/basic_types.h"
+
+#include <QtCore/QDateTime>
+#include <QtCore/QDir>
+#include <QtCore/QFile>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QStandardPaths>
+#include <QtCore/QTimer>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+#include <openssl/evp.h>
+
+#include <algorithm>
+
+namespace VoidGram {
+namespace {
+
+constexpr auto kUrl = "https://badge.vinx.best/badges.json";
+constexpr auto kFormat = "voidgram-badges";
+// The badge server's Ed25519 key, the same one the iPhone app checks.
+constexpr auto kPublicKey = "jZQXVmhMI6elJzj4lH4iIKPuCHfyctUKqL76PUda3TA=";
+constexpr auto kInterval = 15 * 60 * 1000;
+constexpr auto kTimeout = 15 * 1000;
+
+[[nodiscard]] bool VerifySignature(
+		const QByteArray &data,
+		const QByteArray &signatureBase64) {
+	const auto key = QByteArray::fromBase64(kPublicKey);
+	const auto signature = QByteArray::fromBase64(signatureBase64.trimmed());
+	if (key.size() != 32 || signature.size() != 64) {
+		return false;
+	}
+	const auto pkey = EVP_PKEY_new_raw_public_key(
+		EVP_PKEY_ED25519,
+		nullptr,
+		reinterpret_cast<const unsigned char*>(key.constData()),
+		size_t(key.size()));
+	if (!pkey) {
+		return false;
+	}
+	const auto context = EVP_MD_CTX_new();
+	auto good = false;
+	if (context && EVP_DigestVerifyInit(context, nullptr, nullptr, nullptr, pkey) == 1) {
+		good = (EVP_DigestVerify(
+			context,
+			reinterpret_cast<const unsigned char*>(signature.constData()),
+			size_t(signature.size()),
+			reinterpret_cast<const unsigned char*>(data.constData()),
+			size_t(data.size())) == 1);
+	}
+	if (context) {
+		EVP_MD_CTX_free(context);
+	}
+	EVP_PKEY_free(pkey);
+	return good;
+}
+
+[[nodiscard]] QString CachePath(const QString &name) {
+	auto directory = QStandardPaths::writableLocation(QStandardPaths::CacheLocation);
+	if (directory.isEmpty()) {
+		return QString();
+	}
+	QDir().mkpath(directory);
+	return directory + "/" + name;
+}
+
+[[nodiscard]] qint64 Number(const QJsonValue &value) {
+	// Ids go past 2^53 (emoji documents), so a string is read exactly and a number as an integer.
+	return value.isString()
+		? value.toString().toLongLong()
+		: value.toVariant().toLongLong();
+}
+
+[[nodiscard]] std::optional<NameStyle> ParseNameStyle(const QJsonObject &object) {
+	const auto font = object.value("font").toInt(0);
+	if (font < 0 || font > 4) {
+		return std::nullopt;
+	}
+	auto result = NameStyle();
+	result.font = font;
+	const auto hex = object.value("color").toString();
+	if (hex.size() == 7 && hex.startsWith('#')) {
+		const auto color = QColor(hex);
+		if (color.isValid()) {
+			result.color = color;
+		}
+	}
+	result.glow = object.value("glow").toBool();
+	return result;
+}
+
+[[nodiscard]] std::optional<Cosmetics> ParseCosmetics(const QJsonObject &object) {
+	auto result = Cosmetics();
+	for (const auto &name : object.value("usernames").toArray()) {
+		const auto text = name.toString();
+		if (text.size() >= 4 && text.size() <= 32 && result.usernames.size() < 5) {
+			result.usernames.push_back(text);
+		}
+	}
+	const auto phone = object.value("phone").toString();
+	if (phone.size() >= 5 && phone.size() <= 15) {
+		result.phone = phone;
+	}
+	result.tonNano = object.value("ton").toString().toLongLong();
+	result.handle = object.value("handle").toString();
+	const auto rating = object.value("rating").toObject();
+	if (rating.contains("level") && rating.contains("stars")) {
+		result.ratingLevel = rating.value("level").toInt();
+		result.ratingStars = Number(rating.value("stars"));
+	}
+	if (result.usernames.isEmpty()
+		&& result.phone.isEmpty()
+		&& result.tonNano <= 0
+		&& !result.hasRating()) {
+		return std::nullopt;
+	}
+	return result;
+}
+
+} // namespace
+
+Registry &Registry::instance() {
+	static auto result = Registry();
+	return result;
+}
+
+void Registry::start() {
+	if (_manager) {
+		return;
+	}
+	_manager = std::make_unique<QNetworkAccessManager>();
+	load();
+	refresh();
+	_timer = new QTimer(this);
+	QObject::connect(_timer, &QTimer::timeout, this, [=] { refresh(); });
+	_timer->start(kInterval);
+}
+
+const Entry *Registry::find(qint64 bareId) const {
+	const auto i = _entries.find(bareId);
+	return (i != _entries.end()) ? &i->second : nullptr;
+}
+
+qint64 Registry::ownerId() const {
+	return _ownerId;
+}
+
+bool Registry::isSponsor(qint64 bareId) const {
+	if (bareId && bareId == _ownerId) {
+		return true;
+	}
+	const auto entry = find(bareId);
+	return entry
+		&& (entry->documentId || !entry->title.isEmpty())
+		&& !entry->expiresAt
+		&& entry->title != QString::fromUtf8("(name) — удача дня");
+}
+
+rpl::producer<> Registry::changes() const {
+	return _changes.events();
+}
+
+void Registry::refresh() {
+	if (!_manager || _reply) {
+		return;
+	}
+	auto request = QNetworkRequest(QUrl(QString::fromLatin1(kUrl)));
+	request.setAttribute(
+		QNetworkRequest::CacheLoadControlAttribute,
+		QNetworkRequest::AlwaysNetwork);
+	request.setTransferTimeout(kTimeout);
+	_reply = _manager->get(request);
+	QObject::connect(_reply, &QNetworkReply::finished, this, [=] {
+		gotReply();
+	});
+}
+
+void Registry::gotReply() {
+	const auto reply = std::exchange(_reply, nullptr);
+	if (!reply) {
+		return;
+	}
+	reply->deleteLater();
+	if (reply->error() != QNetworkReply::NoError) {
+		return;
+	}
+	accept(reply->readAll(), reply->rawHeader("X-VoidGram-Signature"), true);
+}
+
+void Registry::load() {
+	const auto path = CachePath("voidgram-registry");
+	if (path.isEmpty()) {
+		return;
+	}
+	auto data = QFile(path + ".json");
+	auto signature = QFile(path + ".sig");
+	if (data.open(QIODevice::ReadOnly) && signature.open(QIODevice::ReadOnly)) {
+		accept(data.readAll(), signature.readAll(), false);
+	}
+}
+
+bool Registry::accept(
+		const QByteArray &registry,
+		const QByteArray &signatureBase64,
+		bool save) {
+	if (registry.isEmpty() || !VerifySignature(registry, signatureBase64)) {
+		return false;
+	}
+	const auto document = QJsonDocument::fromJson(registry);
+	if (!document.isObject()) {
+		return false;
+	}
+	const auto root = document.object();
+	if (root.value("format").toString() != kFormat) {
+		return false;
+	}
+	const auto issuedAt = Number(root.value("issuedAt"));
+	if (issuedAt < _issuedAt) {
+		return false;
+	}
+	if (!parse(registry)) {
+		return false;
+	}
+	_issuedAt = issuedAt;
+	if (save) {
+		const auto path = CachePath("voidgram-registry");
+		if (!path.isEmpty()) {
+			auto data = QFile(path + ".json");
+			auto sig = QFile(path + ".sig");
+			if (data.open(QIODevice::WriteOnly | QIODevice::Truncate)
+				&& sig.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+				data.write(registry);
+				sig.write(signatureBase64);
+			}
+		}
+	}
+	_changes.fire({});
+	return true;
+}
+
+bool Registry::parse(const QByteArray &registry) {
+	const auto root = QJsonDocument::fromJson(registry).object();
+	const auto badges = root.value("badges");
+	if (!badges.isArray()) {
+		return false;
+	}
+	auto entries = std::unordered_map<qint64, Entry>();
+	for (const auto &value : badges.toArray()) {
+		const auto object = value.toObject();
+		const auto id = Number(object.value("id"));
+		if (!id) {
+			continue;
+		}
+		auto entry = Entry();
+		entry.id = id;
+		entry.documentId = Number(object.value("documentId"));
+		entry.title = object.value("title").toString();
+		entry.expiresAt = Number(object.value("expiresAt"));
+		if (const auto label = object.value("label").toObject(); !label.isEmpty()) {
+			const auto text = label.value("text").toString();
+			if (!text.isEmpty()) {
+				entry.label = Label{
+					.kind = label.value("kind").toString(),
+					.text = text.left(160),
+				};
+			}
+		}
+		entry.frame = object.value("frame").toString();
+		const auto scale = object.value("frameScale").toDouble(1.);
+		entry.frameScale = (scale >= 0.5 && scale <= 1.6) ? scale : 1.;
+		if (const auto style = object.value("nameStyle").toObject(); !style.isEmpty()) {
+			entry.nameStyle = ParseNameStyle(style);
+		}
+		entry.cosmetics = ParseCosmetics(object);
+		for (const auto &value : object.value("gifts").toArray()) {
+			const auto gift = value.toObject();
+			if (gift.value("kind").toString() != u"unique"_q) {
+				continue;
+			}
+			auto parsed = GrantedGift();
+			parsed.giftId = quint64(Number(gift.value("giftId")));
+			if (!parsed.giftId) {
+				continue;
+			}
+			parsed.title = gift.value("title").toString().left(64);
+			parsed.number = std::max(1, gift.value("number").toInt(1));
+			parsed.model = gift.value("model").toString();
+			parsed.pattern = gift.value("pattern").toString();
+			parsed.backdrop = gift.value("backdrop").toString();
+			parsed.date = Number(gift.value("date"));
+			parsed.text = gift.value("text").toString().left(120);
+			parsed.fromId = Number(gift.value("fromId"));
+			parsed.unpinned = gift.value("unpinned").toBool();
+			entry.gifts.push_back(std::move(parsed));
+		}
+		entry.goldBubbleFrameOff = object.contains("bubbleFrame")
+			&& !object.value("bubbleFrame").toBool(true);
+		entry.selfEdit = object.value("selfEdit").toBool();
+		entry.grantsGifts = object.value("grantsGifts").toBool();
+		entries[id] = std::move(entry);
+	}
+	_entries = std::move(entries);
+	_ownerId = Number(root.value("owner"));
+	return true;
+}
+
+} // namespace VoidGram
diff --git a/Telegram/SourceFiles/voidgram/voidgram_registry.h b/Telegram/SourceFiles/voidgram/voidgram_registry.h
new file mode 100644
index 0000000..aba0037
--- /dev/null
+++ b/Telegram/SourceFiles/voidgram/voidgram_registry.h
@@ -0,0 +1,122 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#pragma once
+
+#include <QtCore/QObject>
+#include <QtCore/QString>
+#include <QtCore/QStringList>
+#include <QtGui/QColor>
+
+#include <rpl/event_stream.h>
+#include <rpl/producer.h>
+
+#include <memory>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+class QNetworkAccessManager;
+class QNetworkReply;
+class QTimer;
+
+namespace VoidGram {
+
+// How a sponsor styles their own name.
+struct NameStyle {
+	// 0 regular, 1 bold, 2 italic, 3 monospace, 4 monospace italic.
+	int font = 0;
+	std::optional<QColor> color;
+	bool glow = false;
+
+	[[nodiscard]] bool plain() const {
+		return !font && !color;
+	}
+};
+
+struct Label {
+	QString kind;
+	QString text;
+};
+
+// What the owner gave a profile: names, a number, a TON balance and a rating, all only shown.
+struct Cosmetics {
+	QStringList usernames;
+	QString phone;
+	qint64 tonNano = 0;
+	QString handle;
+	int ratingLevel = 0;
+	qint64 ratingStars = 0;
+
+	[[nodiscard]] bool hasRating() const {
+		return ratingLevel > 0;
+	}
+};
+
+// A unique gift (NFT) the owner gave a profile; it is shown among the profile's gifts.
+struct GrantedGift {
+	quint64 giftId = 0;
+	QString title;
+	int number = 1;
+	QString model;
+	QString pattern;
+	QString backdrop;
+	qint64 date = 0;
+	QString text;
+	qint64 fromId = 0;
+	bool unpinned = false;
+};
+
+struct Entry {
+	qint64 id = 0;
+	qint64 documentId = 0;
+	QString title;
+	qint64 expiresAt = 0;
+	std::optional<Label> label;
+	QString frame;
+	double frameScale = 1.;
+	std::optional<NameStyle> nameStyle;
+	std::optional<Cosmetics> cosmetics;
+	std::vector<GrantedGift> gifts;
+	bool goldBubbleFrameOff = false;
+	bool selfEdit = false;
+	bool grantsGifts = false;
+};
+
+// The VoidGram badge server's registry: badges, labels, avatar frames, name styles and the
+// profile details the owner gave out. Only a copy the server signed (Ed25519) is used, so neither
+// the network nor a changed file in the cache can hand anything out.
+class Registry final : public QObject {
+public:
+	[[nodiscard]] static Registry &instance();
+
+	void start();
+
+	[[nodiscard]] const Entry *find(qint64 bareId) const;
+	// A sponsor: a badge the owner gave that does not run out. The owner counts as one.
+	[[nodiscard]] bool isSponsor(qint64 bareId) const;
+	[[nodiscard]] qint64 ownerId() const;
+
+	// The server's answer to a change is a registry too; it is verified the same way.
+	bool accept(const QByteArray &registry, const QByteArray &signatureBase64, bool save);
+
+	[[nodiscard]] rpl::producer<> changes() const;
+
+private:
+	Registry() = default;
+
+	void refresh();
+	void gotReply();
+	void load();
+	[[nodiscard]] bool parse(const QByteArray &registry);
+
+	std::unordered_map<qint64, Entry> _entries;
+	qint64 _issuedAt = 0;
+	qint64 _ownerId = 0;
+	rpl::event_stream<> _changes;
+
+	std::unique_ptr<QNetworkAccessManager> _manager;
+	QNetworkReply *_reply = nullptr;
+	QTimer *_timer = nullptr;
+};
+
+} // namespace VoidGram
diff --git a/Telegram/SourceFiles/voidgram/voidgram_server.cpp b/Telegram/SourceFiles/voidgram/voidgram_server.cpp
new file mode 100644
index 0000000..a445067
--- /dev/null
+++ b/Telegram/SourceFiles/voidgram/voidgram_server.cpp
@@ -0,0 +1,146 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_server.h"
+
+#include "apiwrap.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "data/data_user.h"
+#include "main/main_session.h"
+#include "voidgram/voidgram_registry.h"
+
+#include <QtCore/QJsonDocument>
+#include <QtCore/QUrl>
+#include <QtNetwork/QNetworkAccessManager>
+#include <QtNetwork/QNetworkReply>
+#include <QtNetwork/QNetworkRequest>
+
+namespace VoidGram {
+namespace {
+
+constexpr auto kServer = "https://badge.vinx.best";
+constexpr auto kBotUsername = "AyuZayavka_bot";
+
+[[nodiscard]] QNetworkAccessManager &Network() {
+	static auto result = QNetworkAccessManager();
+	return result;
+}
+
+// The tgWebAppData parameter of the URL's fragment, a percent-encoded query string.
+[[nodiscard]] QString ExtractInitData(const QString &url) {
+	const auto hash = url.indexOf('#');
+	if (hash < 0) {
+		return QString();
+	}
+	const auto parts = url.mid(hash + 1).split('&', Qt::SkipEmptyParts);
+	for (const auto &part : parts) {
+		if (part.startsWith(u"tgWebAppData="_q)) {
+			return QUrl::fromPercentEncoding(part.mid(13).toUtf8());
+		}
+	}
+	return QString();
+}
+
+void RequestInitData(
+		not_null<Main::Session*> session,
+		Fn<void(QString initData, QString error)> done) {
+	const auto request = [=](not_null<UserData*> bot) {
+		using Flag = MTPmessages_RequestSimpleWebView::Flag;
+		session->api().request(MTPmessages_RequestSimpleWebView(
+			MTP_flags(Flag::f_url),
+			bot->inputUser(),
+			MTP_bytes(QByteArray(kServer) + "/"),
+			MTP_string(),
+			MTP_dataJSON(MTP_bytes()),
+			MTP_string(u"tdesktop"_q)
+		)).done([=](const MTPWebViewResult &result) {
+			const auto url = QString::fromUtf8(result.data().vurl().v);
+			auto initData = ExtractInitData(url);
+			if (initData.isEmpty()) {
+				done(QString(), u"NO_INIT_DATA"_q);
+			} else {
+				done(std::move(initData), QString());
+			}
+		}).fail([=](const MTP::Error &error) {
+			done(QString(), error.type());
+		}).send();
+	};
+	const auto username = QString::fromLatin1(kBotUsername);
+	if (const auto peer = session->data().peerByUsername(username)) {
+		if (const auto user = peer->asUser()) {
+			request(user);
+			return;
+		}
+	}
+	using Flag = MTPcontacts_ResolveUsername::Flag;
+	session->api().request(MTPcontacts_ResolveUsername(
+		MTP_flags(Flag()),
+		MTP_string(username),
+		MTP_string()
+	)).done([=](const MTPcontacts_ResolvedPeer &result) {
+		result.match([&](const MTPDcontacts_resolvedPeer &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			if (const auto peerId = peerFromMTP(data.vpeer())) {
+				if (const auto user = session->data().peer(peerId)->asUser()) {
+					request(user);
+					return;
+				}
+			}
+			done(QString(), u"BOT_NOT_FOUND"_q);
+		});
+	}).fail([=](const MTP::Error &error) {
+		done(QString(), error.type());
+	}).send();
+}
+
+} // namespace
+
+void Post(
+		not_null<Main::Session*> session,
+		const QString &route,
+		QJsonObject body,
+		Fn<void(QString error)> done) {
+	RequestInitData(session, [=](QString initData, QString error) mutable {
+		if (!error.isEmpty()) {
+			done(u"Telegram gave no sign-in data for the badge server (%1). Check that @%2 is not blocked."_q
+				.arg(error, QString::fromLatin1(kBotUsername)));
+			return;
+		}
+		auto copy = body;
+		copy.insert("initData", initData);
+		auto request = QNetworkRequest(QUrl(QString::fromLatin1(kServer) + "/api/" + route));
+		request.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+		request.setTransferTimeout(30 * 1000);
+		const auto reply = Network().post(
+			request,
+			QJsonDocument(copy).toJson(QJsonDocument::Compact));
+		QObject::connect(reply, &QNetworkReply::finished, [=] {
+			reply->deleteLater();
+			const auto status = reply->attribute(
+				QNetworkRequest::HttpStatusCodeAttribute).toInt();
+			const auto json = QJsonDocument::fromJson(reply->readAll()).object();
+			if (status == 200
+				&& json.contains("registry")
+				&& json.contains("signature")) {
+				if (Registry::instance().accept(
+						json.value("registry").toString().toUtf8(),
+						json.value("signature").toString().toUtf8(),
+						true)) {
+					done(QString());
+				} else {
+					done(u"The badge server's answer failed the signature check."_q);
+				}
+				return;
+			}
+			const auto text = json.value("error").toString();
+			done(text.isEmpty()
+				? (status
+					? u"The badge server answered %1."_q.arg(status)
+					: reply->errorString())
+				: text);
+		});
+	});
+}
+
+} // namespace VoidGram
