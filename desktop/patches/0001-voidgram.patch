+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#pragma once
+
+#include "base/basic_types.h"
+#include "ui/rp_widget.h"
+
+#include <QtCore/QByteArray>
+#include <QtCore/QString>
+#include <QtGui/QImage>
+
+#include <memory>
+#include <optional>
+#include <vector>
+
+namespace VoidGram {
+
+// A looping animated PNG, every frame already composed onto the full canvas.
+struct AnimatedFrame {
+	std::vector<QImage> images;
+	std::vector<int> delaysMs;
+	int totalMs = 0;
+	QSize size;
+
+	// A frame's image is this wide (in canvas pixels) for the regular size; a wider one (wings)
+	// spills past the avatar on every side. The avatar's own circle is always 178 px wide.
+	[[nodiscard]] double extent() const;
+};
+
+[[nodiscard]] std::shared_ptr<AnimatedFrame> DecodeApng(const QByteArray &data);
+
+struct FrameEntry {
+	QString id;
+	QString titleRu;
+	QString titleEn;
+};
+
+// Frames come from the badge server's catalog, are downloaded once and kept in the cache folder
+// (fetched again after a day, so a frame the owner redraws reaches everybody).
+void LoadFrame(
+	const QString &id,
+	Fn<void(std::shared_ptr<AnimatedFrame>)> done);
+void LoadCatalog(Fn<void(std::vector<FrameEntry>)> done);
+
+// The avatar's clear circle fills this part of a regular frame's width.
+inline constexpr auto kAvatarFraction = 178. / 240.;
+
+// Plays a frame around an avatar. The widget is as large as the frame is drawn, and a wide frame
+// (wings) is larger than the avatar by far, so the widget lives in a parent that does not clip it.
+class FrameWidget final : public Ui::RpWidget {
+public:
+	explicit FrameWidget(QWidget *parent);
+
+	void setFrame(const QString &id);
+	void setUserScale(double scale);
+	// The frame is shrunk to the avatar's rect enlarged by 1 / kAvatarFraction, for a list of frames.
+	void setFitsInside(bool fits);
+
+	// Puts the widget around an avatar given in the parent's coordinates.
+	void placeAround(QRect avatar);
+	[[nodiscard]] double extent() const;
+
+	[[nodiscard]] rpl::producer<> extentChanged() const;
+
+protected:
+	void paintEvent(QPaintEvent *e) override;
+
+private:
+	void tick();
+
+	QString _id;
+	std::shared_ptr<AnimatedFrame> _frame;
+	double _userScale = 1.;
+	bool _fitsInside = false;
+	QRect _avatar;
+	int _index = 0;
+	QTimer *_timer = nullptr;
+	rpl::event_stream<> _extentChanged;
+
+};
+
+} // namespace VoidGram
