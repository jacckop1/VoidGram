+void installLinuxIcon() {
+#ifdef Q_OS_LINUX
+	loadIcons();
+	if (LAST_LOADED.isNull()) {
+		return;
+	}
+	auto roots = QStringList{ QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation) };
+	for (const auto &dir : qEnvironmentVariable("XDG_DATA_DIRS").split(':', Qt::SkipEmptyParts)) {
+		if (dir.startsWith(QDir::homePath() + '/')) {
+			roots.push_back(dir);
+		}
+	}
+	for (const auto size : { 16, 24, 32, 48, 64, 128, 256, 512 }) {
+		auto image = CreateImage(LAST_LOADED_NAME, QSize(size, size));
+		if (image.isNull()) {
+			continue;
+		}
+		image = image.scaled(size, size, Qt::IgnoreAspectRatio, Qt::SmoothTransformation);
+		image.setDevicePixelRatio(1.);
+		for (const auto &root : roots) {
+			const auto dir = QStringLiteral("%1/icons/hicolor/%2x%2/apps").arg(root).arg(size);
+			if (QDir().mkpath(dir)) {
+				image.save(dir + u"/com.voidgram.desktop.png"_q, "PNG");
+			}
+		}
+	}
+#endif
+}
+
 QString currentAppLogoName() {
 	return LAST_LOADED_NAME;
 }
