+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#pragma once
+
+#include <QtCore/QRect>
+#include <QtGui/QPainter>
+
+namespace VoidGram {
+
+enum class BubbleSkin {
+	None,
+	Badge, // The grey skin with the VoidGram mark repeated over it.
+	Owner, // The same skin in a gold frame.
+};
+
+// The skin of a sponsor's (or the owner's) message bubbles.
+[[nodiscard]] BubbleSkin BubbleSkinFor(qint64 bareId);
+
+// Paints the skin over a bubble at `geometry`: a gradient, the mark repeated over it, and for the
+// owner a gold frame. `dark` picks the dark or light variant.
+void PaintBubbleSkin(
+	QPainter &p,
+	const QRect &geometry,
+	BubbleSkin skin,
+	bool dark,
+	double radius);
+
+} // namespace VoidGram
