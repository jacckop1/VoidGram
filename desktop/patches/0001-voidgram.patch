diff --git a/Telegram/SourceFiles/voidgram/voidgram_skin.cpp b/Telegram/SourceFiles/voidgram/voidgram_skin.cpp
new file mode 100644
index 0000000..5aa2670
--- /dev/null
+++ b/Telegram/SourceFiles/voidgram/voidgram_skin.cpp
@@ -0,0 +1,106 @@
+// This file is part of VoidGram for Desktop, a fork of AyuGram Desktop.
+// It is licensed under GPLv3 with the same exceptions as the rest of the code.
+#include "voidgram/voidgram_skin.h"
+
+#include "voidgram/voidgram_registry.h"
+
+#include <QtCore/QByteArray>
+#include <QtGui/QImage>
+#include <QtGui/QLinearGradient>
+#include <QtGui/QPainterPath>
+#include <QtSvg/QSvgRenderer>
+
+namespace VoidGram {
+namespace {
+
+constexpr auto kTile = 56;
+
+const auto kMark = QByteArray(
+	R"svg(<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024" viewBox="0 0 1024 1024"><g transform="translate(-208.795 -109.900) scale(1.26789)"><path d="M534.53 244.08 A4.00 4.00 0 0 1 542.00 246.06 L542.00 528.44 A4.00 4.00 0 0 1 541.47 530.42 L417.16 747.98 A4.00 4.00 0 0 1 413.68 750.00 L304.03 750.00 A34.00 34.00 0 0 1 274.51 699.13 Z M862.49 699.13 A34.00 34.00 0 0 1 832.97 750.00 L723.32 750.00 A4.00 4.00 0 0 1 719.84 747.98 L595.53 530.42 A4.00 4.00 0 0 1 595.00 528.44 L595.00 246.06 A4.00 4.00 0 0 1 602.47 244.08 Z" fill="#000000"/><path d="M560.69 585.68 A9.00 9.00 0 0 1 576.31 585.68 L662.52 736.53 A9.00 9.00 0 0 1 654.70 750.00 L482.30 750.00 A9.00 9.00 0 0 1 474.48 736.53 Z" fill="#000000"/></g></svg>)svg");
+
+// One tile of the pattern: the mark, small, in the given colour; the tile repeats.
+[[nodiscard]] QImage Tile(const QColor &color) {
+	auto result = QImage(kTile * 2, kTile * 2, QImage::Format_ARGB32_Premultiplied);
+	result.fill(Qt::transparent);
+	auto svg = QSvgRenderer(kMark);
+	auto mark = QImage(kTile / 2 * 2, kTile / 2 * 2, QImage::Format_ARGB32_Premultiplied);
+	mark.fill(Qt::transparent);
+	{
+		auto q = QPainter(&mark);
+		svg.render(&q, QRectF(0, 0, mark.width(), mark.height()));
+		q.setCompositionMode(QPainter::CompositionMode_SourceIn);
+		q.fillRect(mark.rect(), color);
+	}
+	auto p = QPainter(&result);
+	p.setRenderHint(QPainter::SmoothPixmapTransform);
+	// Two marks per tile, offset, so the rows stagger.
+	p.drawImage(QRect(kTile / 4, kTile / 4, kTile / 2, kTile / 2), mark);
+	p.drawImage(QRect(kTile + kTile / 4, kTile + kTile / 4, kTile / 2, kTile / 2), mark);
+	return result;
+}
+
+} // namespace
+
+BubbleSkin BubbleSkinFor(qint64 bareId) {
+	const auto &registry = Registry::instance();
+	if (!bareId || !registry.isSponsor(bareId)) {
+		return BubbleSkin::None;
+	}
+	if (bareId == registry.ownerId()) {
+		const auto entry = registry.find(bareId);
+		return (entry && entry->goldBubbleFrameOff)
+			? BubbleSkin::Badge
+			: BubbleSkin::Owner;
+	}
+	return BubbleSkin::Badge;
+}
+
+void PaintBubbleSkin(
+		QPainter &p,
+		const QRect &geometry,
+		BubbleSkin skin,
+		bool dark,
+		double radius) {
+	if (skin == BubbleSkin::None || geometry.isEmpty()) {
+		return;
+	}
+	static const auto lightTile = Tile(QColor(0, 0, 0, 15));
+	static const auto darkTile = Tile(QColor(255, 255, 255, 18));
+
+	auto path = QPainterPath();
+	path.addRoundedRect(QRectF(geometry), radius, radius);
+
+	auto gradient = QLinearGradient(geometry.topRight(), geometry.bottomLeft());
+	if (dark) {
+		gradient.setColorAt(0., QColor(0x06, 0x06, 0x06));
+		gradient.setColorAt(0.45, QColor(0x2A, 0x29, 0x27));
+		gradient.setColorAt(1., QColor(0x73, 0x70, 0x69));
+	} else {
+		gradient.setColorAt(0., QColor(0xF4, 0xF3, 0xF1));
+		gradient.setColorAt(0.45, QColor(0xE4, 0xE2, 0xDF));
+		gradient.setColorAt(1., QColor(0xC9, 0xC6, 0xC1));
+	}
+	p.save();
+	p.setRenderHint(QPainter::Antialiasing);
+	p.setPen(Qt::NoPen);
+	p.setBrush(gradient);
+	p.drawPath(path);
+	auto brush = QBrush(dark ? darkTile : lightTile);
+	brush.setTransform(QTransform::fromTranslate(geometry.x(), geometry.y()));
+	p.setBrush(brush);
+	p.drawPath(path);
+	if (skin == BubbleSkin::Owner) {
+		auto frame = QLinearGradient(geometry.topLeft(), geometry.bottomRight());
+		frame.setColorAt(0., QColor(0xF3, 0xD2, 0x7A));
+		frame.setColorAt(0.5, QColor(0xC8, 0x95, 0x2B));
+		frame.setColorAt(1., QColor(0xF3, 0xD2, 0x7A));
+		p.setBrush(Qt::NoBrush);
+		p.setPen(QPen(QBrush(frame), 2.5));
+		auto outer = QPainterPath();
+		outer.addRoundedRect(QRectF(geometry).adjusted(-1.25, -1.25, 1.25, 1.25), radius + 1.25, radius + 1.25);
+		p.drawPath(outer);
+	}
+	p.restore();
+}
+
+} // namespace VoidGram
