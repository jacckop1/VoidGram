+	, _frame(this)
+	, _label(this, user->name(), _state) {
+		resize(width(), kPreviewHeight);
+		user->session().downloaderTaskFinished(
+		) | rpl::on_next([=] {
+			update();
+		}, lifetime());
+		_frame.setUserScale(_state->scale);
+		_frame.setFrame(_state->frame);
+		_state->changed.events(
+		) | rpl::on_next([=] {
+			_frame.setUserScale(_state->scale);
+			_frame.setFrame(_state->frame);
+			layoutChildren();
+			update();
+		}, lifetime());
+		sizeValue(
+		) | rpl::on_next([=] {
+			layoutChildren();
+		}, lifetime());
+		_label.show();
+	}
+
+	int resizeGetHeight(int newWidth) override {
+		return kPreviewHeight;
+	}
+
+private:
+	[[nodiscard]] QRect avatarRect() const {
+		return QRect(
+			(width() - kAvatarSize) / 2,
+			(kPreviewHeight - 40 - kAvatarSize) / 2 + 4,
+			kAvatarSize,
+			kAvatarSize);
