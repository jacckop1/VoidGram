+[[nodiscard]] auto StyledFont(const style::TextStyle &base, int variant) {
+	switch (variant) {
+	case 1: return base.font->bold();
+	case 2: return base.font->italic();
+	case 3: return base.font->monospace();
+	case 4: return base.font->monospace()->italic();
+	}
+	return base.font;
+}
+
+} // namespace
+
+const NameStyle *NameStyleFor(qint64 bareId) {
+	const auto &registry = Registry::instance();
+	if (!registry.isSponsor(bareId)) {
+		return nullptr;
+	}
+	const auto entry = registry.find(bareId);
+	return (entry && entry->nameStyle && !entry->nameStyle->plain())
+		? &*entry->nameStyle
+		: nullptr;
+}
+
+const style::TextStyle &StyledTextStyle(
+		const style::TextStyle &base,
+		const NameStyle *style) {
+	if (!style || !style->font) {
+		return base;
+	}
+	static auto cache = std::map<
+		std::pair<const style::TextStyle*, int>,
+		std::unique_ptr<style::TextStyle>>();
+	auto &entry = cache[{ &base, style->font }];
+	if (!entry) {
+		entry = std::make_unique<style::TextStyle>(base);
+		entry->font = StyledFont(base, style->font);
+	}
+	return *entry;
+}
+
+const style::FlatLabel &StyledLabelStyle(
+		const style::FlatLabel &base,
+		const NameStyle *style) {
+	if (!style || !style->font) {
+		return base;
+	}
+	static auto cache = std::map<
+		std::pair<const style::FlatLabel*, int>,
+		std::unique_ptr<style::FlatLabel>>();
+	auto &entry = cache[{ &base, style->font }];
+	if (!entry) {
+		entry = std::make_unique<style::FlatLabel>(base);
+		entry->style = StyledTextStyle(base.style, style);
+	}
+	return *entry;
+}
+
+} // namespace VoidGram
