+
+constexpr Wallpaper kList[] = {
+	{ "black", "Чёрные", "Black" },
+	{ "blue", "Синие", "Blue" },
+	{ "purple", "Пурпурные", "Purple" },
+	{ "red", "Красные", "Red" },
+	{ "violet", "Фиолетовые", "Violet" },
+};
+
+[[nodiscard]] QImage Load(const char *file) {
+	return QImage(u":/gui/art/voidgram/wallpaper_%1.jpg"_q.arg(QLatin1String(file)));
+}
+
+class Cell final : public Ui::AbstractButton {
+public:
+	Cell(QWidget *parent, const Wallpaper &wallpaper)
+	: AbstractButton(parent)
+	, _image(Load(wallpaper.file))
+	, _title(Lang::Id().startsWith(u"ru"_q)
+		? QString::fromUtf8(wallpaper.ru)
+		: QString::fromUtf8(wallpaper.en)) {
+	}
+
+	void setWidth(int side) {
+		resize(side, int(side * 1.9) + st::normalFont->height + 8);
+	}
+
+	[[nodiscard]] QImage image() const {
+		return _image;
+	}
+
+private:
+	void paintEvent(QPaintEvent *e) override {
+		auto p = QPainter(this);
+		p.setRenderHint(QPainter::Antialiasing);
+		p.setRenderHint(QPainter::SmoothPixmapTransform);
+		const auto picture = QRect(0, 0, width(), height() - st::normalFont->height - 8);
+		auto path = QPainterPath();
+		path.addRoundedRect(QRectF(picture), 10, 10);
+		p.setClipPath(path);
+		if (!_image.isNull()) {
+			const auto scaled = _image.scaled(
+				picture.size() * style::DevicePixelRatio(),
+				Qt::KeepAspectRatioByExpanding,
+				Qt::SmoothTransformation);
+			const auto from = QRect(
+				(scaled.width() - picture.width() * style::DevicePixelRatio()) / 2,
+				(scaled.height() - picture.height() * style::DevicePixelRatio()) / 2,
+				picture.width() * style::DevicePixelRatio(),
+				picture.height() * style::DevicePixelRatio());
+			p.drawImage(picture, scaled, from);
+		}
+		p.setClipping(false);
+		p.setPen(st::windowFg->c);
+		p.setFont(st::normalFont);
+		p.drawText(
+			QRect(0, height() - st::normalFont->height - 4, width(), st::normalFont->height + 4),
+			Qt::AlignCenter,
+			_title);
+	}
+
+	QImage _image;
+	QString _title;
+
+};
+
+class Grid final : public Ui::RpWidget {
+public:
+	Grid(QWidget *parent, not_null<Window::SessionController*> controller)
+	: RpWidget(parent) {
+		for (const auto &wallpaper : kList) {
+			auto cell = std::make_unique<Cell>(this, wallpaper);
+			const auto raw = cell.get();
+			cell->setClickedCallback([=] {
+				auto image = raw->image();
+				if (image.isNull()) {
+					return;
+				}
+				auto local = Data::CustomWallPaper();
+				local.setLocalImageAsThumbnail(std::make_shared<Image>(std::move(image)));
+				controller->show(Box<BackgroundPreviewBox>(
+					controller,
+					local,
+					BackgroundPreviewArgs()));
+			});
+			cell->show();
+			_cells.push_back(std::move(cell));
+		}
+	}
+
+	int resizeGetHeight(int newWidth) override {
+		const auto columns = 3;
+		const auto skip = 10;
+		const auto side = std::max((newWidth - skip * (columns - 1)) / columns, 40);
+		auto bottom = 0;
+		auto index = 0;
+		for (const auto &cell : _cells) {
+			cell->setWidth(side);
+			cell->move(
+				(index % columns) * (side + skip),
+				(index / columns) * (cell->height() + skip));
+			bottom = std::max(bottom, cell->y() + cell->height());
+			++index;
+		}
+		return bottom;
+	}
+
+private:
+	std::vector<std::unique_ptr<Cell>> _cells;
+
+};
+
+} // namespace
+
+void WallpapersBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	box->setTitle(rpl::single(Lang::Id().startsWith(u"ru"_q)
+		? QString::fromUtf8("Обои VoidGram")
+		: QString("VoidGram wallpapers")));
+	box->setWidth(st::boxWideWidth);
+	box->addRow(object_ptr<Grid>(box, controller), st::boxRowPadding);
+	box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+}
+
+} // namespace VoidGram
